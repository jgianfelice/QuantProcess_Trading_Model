//@version=6
strategy('Institutional Quant Strategy', 
         overlay=true, 
         default_qty_type=strategy.percent_of_equity, 
         default_qty_value=100, 
         commission_type=strategy.commission.percent, 
         commission_value=0.1,
         max_bars_back=500)

// ============================================================================
// QUANTPROCESS TRADING MODEL - OPTIMIZED FOR TRADINGVIEW
// ============================================================================

// =================================
// USER INPUTS
// =================================

// Regime Detection
vol_lookback   = input.int(20, 'Volatility Period', minval=5, maxval=100, group='Regime Detection')
trend_strength = input.int(25, 'Trend Strength (ADX)', minval=15, maxval=40, group='Regime Detection')
regime_confirm = input.int(3, 'Confirmation Days', minval=1, maxval=10, group='Regime Detection')

// Signal Thresholds
trending_buy    = input.float(0.5,  'Buy Threshold',      minval=0,   maxval=2,  step=0.1, group='Signal Thresholds')
trending_sell   = input.float(-0.5, 'Sell Threshold',     minval=-2,  maxval=0,  step=0.1, group='Signal Thresholds')
rsi_oversold    = input.int(30,     'RSI Oversold',       minval=10,  maxval=40, group='Signal Thresholds')
rsi_overbought  = input.int(70,     'RSI Overbought',     minval=60,  maxval=90, group='Signal Thresholds')

// Risk Management
use_stops    = input.bool(true,  'Enable Stop Loss',    group='Risk Management')
stop_loss_pct= input.float(5.0,  'Stop Loss %',         minval=1, maxval=20, step=0.5, group='Risk Management')
use_trailing = input.bool(true,  'Enable Trailing Stop',group='Risk Management')
trailing_pct = input.float(10.0, 'Trailing Stop %',     minval=5, maxval=30, step=1,   group='Risk Management')

// Display Options
show_signals   = input.bool(true,  'Show Buy/Sell Signals', group='Display')
show_regime_bg = input.bool(false, 'Show Regime Background', group='Display')
show_stats     = input.bool(true,  'Show Statistics Panel',  group='Display')

// Bollinger Bands (visual only, MSTS-style)
grp_bb      = 'Bollinger Bands (Visual)'
bb_period   = input.int(20, 'BB Period',          minval=5,  maxval=100, group=grp_bb)
bb_std      = input.float(2.0, 'BB Std Dev',      minval=0.5,maxval=4.0, step=0.1, group=grp_bb)
show_bb     = input.bool(true, 'Show Bollinger Bands',       group=grp_bb)

// =================================
// REGIME DETECTION
// =================================

returns      = math.log(close / close[1])
realized_vol = ta.stdev(returns, vol_lookback) * math.sqrt(252)
vol_ma       = ta.sma(realized_vol, 50)
high_vol     = realized_vol > vol_ma * 1.2

tr               = high - low
atr              = ta.sma(tr, 14)
direction_change = math.abs(close - close[1])
adx_approx       = ta.sma(direction_change, 14) / atr * 100

ma_fast = ta.sma(close, 20)
ma_slow = ta.sma(close, 50)
uptrend = ma_fast > ma_slow

var string regime      = 'Neutral'
var int    regime_count= 0

is_trending = adx_approx > trend_strength and not high_vol
is_range    = adx_approx < trend_strength and not high_vol
is_volatile = high_vol

if is_trending
    if regime != 'Trending'
        regime_count += 1
        if regime_count >= regime_confirm
            regime      := 'Trending'
            regime_count := 0
    else
        regime_count := 0
else if is_range
    if regime != 'Range'
        regime_count += 1
        if regime_count >= regime_confirm
            regime      := 'Range'
            regime_count := 0
    else
        regime_count := 0
else if is_volatile
    if regime != 'Volatile'
        regime_count += 1
        if regime_count >= regime_confirm
            regime      := 'Volatile'
            regime_count := 0
    else
        regime_count := 0

// =================================
// FACTOR CALCULATIONS
// =================================

mom_fast      = ta.roc(close, 20)
mom_slow      = ta.roc(close, 50)
momentum_raw  = (mom_fast + mom_slow) / 2
mom_mean      = ta.sma(momentum_raw, 100)
mom_std       = ta.stdev(momentum_raw, 100)
momentum_score= (momentum_raw - mom_mean) / mom_std

vol_short = ta.stdev(returns, 20) * math.sqrt(252)
vol_mean  = ta.sma(vol_short, 100)
vol_std   = ta.stdev(vol_short, 100)
vol_score = -(vol_short - vol_mean) / vol_std

rsi = ta.rsi(close, 14)

// =================================
// SIGNAL GENERATION
// =================================

var int signal = 0

if regime == 'Trending'
    combined_score = momentum_score * 0.7 + vol_score * 0.3
    if combined_score > trending_buy and uptrend
        signal := 1
    else if combined_score < trending_sell and not uptrend
        signal := -1
    else
        signal := 0
else if regime == 'Range'
    if rsi < rsi_oversold
        signal := 1
    else if rsi > rsi_overbought
        signal := -1
    else
        signal := 0
else if regime == 'Volatile'
    if momentum_score > 1.5 and uptrend
        signal := 1
    else if momentum_score < -1.5 and not uptrend
        signal := -1
    else
        signal := 0
else
    signal := 0

// =================================
// POSITION SIZING
// =================================

position_qty = regime == 'Volatile' ? 50.0 : 100.0

// =================================
// ENTRY/EXIT LOGIC
// =================================

longCondition      = signal == 1  and strategy.position_size == 0
shortCondition     = signal == -1 and strategy.position_size == 0
exitLongCondition  = signal == -1 and strategy.position_size > 0
exitShortCondition = signal == 1  and strategy.position_size < 0

if longCondition
    strategy.entry('Long', strategy.long, qty=position_qty)

if shortCondition
    strategy.entry('Short', strategy.short, qty=position_qty)

if exitLongCondition
    strategy.close('Long')

if exitShortCondition
    strategy.close('Short')

// =================================
// RISK MANAGEMENT
// =================================

if use_stops and strategy.position_size != 0
    if strategy.position_size > 0
        strategy.exit('SL', 'Long',  stop=close * (1 - stop_loss_pct/100))
    else
        strategy.exit('SL', 'Short', stop=close * (1 + stop_loss_pct/100))

if use_trailing and strategy.position_size != 0
    if strategy.position_size > 0
        strategy.exit('Trail', 'Long',  trail_price=close, trail_offset=close * trailing_pct/100)
    else
        strategy.exit('Trail', 'Short', trail_price=close, trail_offset=close * trailing_pct/100)

// =================================
// VISUALS: REGIME, BOLLINGER, LABELS
// =================================

regime_bg_color = show_regime_bg ?
     (regime == 'Trending' ? color.new(color.green,  90) :
      regime == 'Range'    ? color.new(color.orange, 90) :
      regime == 'Volatile' ? color.new(color.red,    90) : na) : na
bgcolor(regime_bg_color)

bb_mid   = ta.sma(close, bb_period)
bb_dev   = ta.stdev(close, bb_period)
bb_upper = bb_mid + bb_std * bb_dev
bb_lower = bb_mid - bb_std * bb_dev

bb_upper_plot = plot(show_bb ? bb_upper : na, title='BB Upper', color=color.new(color.red,   60), linewidth=1)
bb_lower_plot = plot(show_bb ? bb_lower : na, title='BB Lower', color=color.new(color.green, 60), linewidth=1)
plot(show_bb ? bb_mid : na, title='BB Mid', color=color.new(color.gray, 40), linewidth=1, style=plot.style_circles)
fill(bb_upper_plot, bb_lower_plot, color=color.new(color.blue, 92), title='BB Fill')

buy_signal = longCondition and show_signals
plotshape(
     buy_signal,
     title     = 'BUY',
     style     = shape.labelup,
     location  = location.belowbar,
     color     = color.new(color.green, 0),
     text      = 'BUY',
     textcolor = color.white,
     size      = size.small
)

sell_signal = shortCondition and show_signals
plotshape(
     sell_signal,
     title     = 'SELL',
     style     = shape.labeldown,
     location  = location.abovebar,
     color     = color.new(color.red, 0),
     text      = 'SELL',
     textcolor = color.white,
     size      = size.small
)

// =================================
// CONSENSUS LABEL (MSTS-style)
// =================================

string consensus_str =
     signal == 1  and regime == 'Trending' ? 'STRONG BUY'  :
     signal == 1  and regime == 'Range'    ? 'BUY'         :
     signal == 1  and regime == 'Volatile' ? 'BUY'         :
     signal == -1 and regime == 'Trending' ? 'STRONG SELL' :
     signal == -1 and regime == 'Range'    ? 'SELL'        :
     signal == -1 and regime == 'Volatile' ? 'SELL'        :
     'HOLD'

color consensus_color =
     consensus_str == 'STRONG BUY'  ? color.new(color.green, 0)  :
     consensus_str == 'BUY'         ? color.new(color.lime,  0)  :
     consensus_str == 'HOLD'        ? color.new(color.orange,0)  :
     consensus_str == 'SELL'        ? color.new(color.red,   0)  :
     consensus_str == 'STRONG SELL' ? color.new(color.maroon,0)  :
     color.gray

if barstate.islast
    label.new(
         bar_index, high * 1.02,
         text      = '⬤ ' + consensus_str + '\nRegime: ' + regime,
         style     = label.style_label_left,
         color     = color.new(color.black, 80),
         textcolor = consensus_color,
         size      = size.normal)

// =================================
// PROFESSIONAL STATISTICS PANEL (MSTS-style)
// =================================

pos_status = strategy.position_size > 0 ? 'LONG' : strategy.position_size < 0 ? 'SHORT' : 'FLAT'
pos_color  = strategy.position_size > 0 ? color.green : strategy.position_size < 0 ? color.red : color.gray

if show_stats
    var table stats = table.new(position.top_right, 2, 10, 
                                bgcolor=color.new(color.black, 70),
                                border_width=1,
                                border_color=color.new(color.white, 50),
                                frame_width=1,
                                frame_color=color.new(color.white, 30))
    
    total_trades  = strategy.closedtrades
    win_trades    = strategy.wintrades
    win_rate      = total_trades > 0 ? win_trades / total_trades * 100 : 0
    profit_factor = strategy.grossprofit / math.max(strategy.grossloss, 1)

    sharpe_ratio = (momentum_score - vol_score)

    regime_color = regime == 'Trending' ? color.new(color.green,  0) :
                   regime == 'Range'    ? color.new(color.orange, 0) :
                   regime == 'Volatile' ? color.new(color.red,    0) : color.gray
    wr_color  = win_rate >= 60 ? color.lime   : win_rate >= 50 ? color.yellow : color.red
    pf_color  = profit_factor >= 2.0 ? color.lime : profit_factor >= 1.5 ? color.yellow : color.red
    np_color  = strategy.netprofit > 0 ? color.lime : color.red
    sharpe_color = sharpe_ratio >= 1.0 ? color.lime : sharpe_ratio >= 0.0 ? color.yellow : color.red

    table.cell(stats, 0, 0, '📊 STRATEGY METRICS', 
              text_color=color.white, 
              text_size=size.small,
              text_halign=text.align_center,
              bgcolor=color.new(color.navy, 40))
    table.cell(stats, 1, 0, regime + ' Regime', 
              text_color=regime_color, 
              text_size=size.small,
              text_halign=text.align_center,
              bgcolor=color.new(color.navy, 40))

    table.cell(stats, 0, 1, 'Win Rate', text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 1, str.format('{0,number,#.#}%', win_rate), text_color=wr_color, text_size=size.small)

    table.cell(stats, 0, 2, 'Profit Factor', text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 2, str.format('{0,number,#.##}', profit_factor), text_color=pf_color, text_size=size.small)

    table.cell(stats, 0, 3, 'Trades', text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 3, str.tostring(total_trades), text_color=color.white, text_size=size.small)

    table.cell(stats, 0, 4, 'Net Profit', text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 4, str.format('{0,number,#.##}%', strategy.netprofit), text_color=np_color, text_size=size.small)

    table.cell(stats, 0, 5, 'Max DD', text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 5, str.format('{0,number,#.##}%', strategy.max_drawdown), text_color=color.red, text_size=size.small)

    // ⭐ NEW SHARPE RATIO ROW ⭐
    table.cell(stats, 0, 6, 'Sharpe', text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 6, str.format('{0,number,#.##}', sharpe_ratio), text_color=sharpe_color, text_size=size.small)

    table.cell(stats, 0, 7, '---------------', text_color=color.new(color.gray, 70), text_size=size.tiny)
    table.cell(stats, 1, 7, '---------------', text_color=color.new(color.gray, 70), text_size=size.tiny)

    table.cell(stats, 0, 8, 'Position', text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 8, pos_status, text_color=pos_color, text_size=size.small)

    table.cell(stats, 0, 9, 'Consensus', text_color=color.silver, text_size=size.small)
    table.cell(stats, 1, 9, consensus_str, text_color=consensus_color, text_size=size.small)

// =================================
// ALERTS
// =================================

alertcondition(longCondition, 
              title='BUY Signal', 
              message='BUY Signal Generated')

alertcondition(shortCondition, 
              title='SELL Signal', 
              message='SELL Signal Generated')

alertcondition(regime == 'Volatile', 
              title='High Volatility Alert', 
              message='HIGH VOLATILITY - Reduce position size')
