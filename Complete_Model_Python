class UserInterface:
    """Handle user input and interaction"""

    @staticmethod
    def get_ticker_input() -> str:
        """Get ticker symbol from user"""
        while True:
            ticker = input("\nEnter ticker symbol (or 'portfolio' for multi-asset analysis): ").strip().upper()

            if ticker == 'PORTFOLIO':
                return ticker

            if ticker:
                is_valid, message = DataManager.validate_ticker(ticker)
                print(message)

                if is_valid:
                    return ticker
                else:
                    retry = input("Would you like to try another ticker? (y/n): ").strip().lower()
                    if retry != 'y':
                        return None
            else:
                print("Please enter a valid ticker symbol.")

    @staticmethod
    def get_portfolio_tickers() -> List[str]:
        """Get list of tickers for portfolio analysis"""
        print("\nEnter ticker symbols for portfolio analysis (comma-separated):")
        print("Example: SPY,QQQ,IWM,EFA,EEM")

        while True:
            tickers_input = input("Tickers: ").strip().upper()
            tickers = [t.strip() for t in tickers_input.split(',') if t.strip()]

            if len(tickers) < 2:
                print("Please enter at least 2 tickers for portfolio analysis.")
                continue

            # Validate all tickers
            valid_tickers = []
            for ticker in tickers:
                is_valid, message = DataManager.validate_ticker(ticker)
                print(f"{ticker}: {message}")
                if is_valid:
                    valid_tickers.append(ticker)

            if len(valid_tickers) >= 2:
                return valid_tickers
            else:
                print("Not enough valid tickers. Please try again.")

    @staticmethod
    def get_weighting_method() -> str:
        """Get portfolio weighting method"""
        print("\nSelect portfolio weighting method:")
        print("1. Equal Weight (1/N allocation)")
        print("2. Volatility Scaled (inverse volatility)")
        print("3. Risk Parity (equal risk contribution)")
        print("4. Momentum Weighted (favor recent winners)")

        method_map = {
            '1': 'equal_weight',
            '2': 'vol_scaled',
            '3': 'risk_parity',
            '4': 'momentum'
        }

        while True:
            choice = input("Enter choice (1/2/3/4, default: 2): ").strip()
            if not choice:
                return 'vol_scaled'  # Default
            if choice in method_map:
                return method_map[choice]
            print("Invalid choice. Please enter 1, 2, 3, or 4.")

    @staticmethod
    def get_analysis_mode() -> str:
        """Get analysis mode from user"""
        print("\nSelect analysis mode:")
        print("1. Current Trading Signals Only")
        print("2. Full Backtest Analysis")
        print("3. Both Signals and Backtest")
        print("4. Enhanced Backtest (Portfolio-level with costs)")
        print("5. Walk-Forward Analysis (Train/Test with re-optimization)")
        print("6. Machine Learning (Linear/Logistic Regression)")
        print("7. Market Regime Analysis (Volatility/Trend Detection)")

        while True:
            choice = input("Enter choice (1/2/3/4/5/6/7): ").strip()
            if choice in ['1', '2', '3', '4', '5', '6', '7']:
                return choice
            if not choice:
                print("No input received. Please enter a number 1-7.")
            else:
                print(f"Invalid choice '{choice}'. Please enter 1, 2, 3, 4, 5, 6, or 7.")

    @staticmethod
    def get_date_range() -> Tuple[str, Optional[str]]:
        """Get custom date range from user"""
        use_custom = input("\nUse custom date range? (y/n, default: n): ").strip().lower()

        if use_custom == 'y':
            start_date = input(f"Start date (YYYY-MM-DD, default: {Config.START_DATE}): ").strip()
            start_date = start_date if start_date else Config.START_DATE

            end_date = input("End date (YYYY-MM-DD, default: today): ").strip()
            end_date = end_date if end_date else None

            return start_date, end_date

        return Config.START_DATE, None

