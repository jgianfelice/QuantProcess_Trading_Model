class TradingSignalGenerator:
    """Generate current trading signals for a given security"""
    
    def __init__(self, ticker: str, price_data: pd.Series, returns: pd.Series):
        self.ticker = ticker
        self.price = price_data
        self.returns = returns
        self.current_price = price_data.iloc[-1]
        self.signals = {}
        
    def generate_all_signals(self) -> Dict[str, Dict]:
        """Generate signals from all available strategies"""
        
        # Moving Average Strategy
        ma_strategy = MovingAverageTrend(self.price, Config.MA_FAST, Config.MA_SLOW)
        ma_signal = ma_strategy.generate_signal()
        self.signals['MA_Crossover'] = self._format_signal(
            ma_signal,
            "Moving Average Crossover (50/200)",
            self._get_ma_details()
        )
        
        # Mean Reversion (Z-Score)
        mr_strategy = MeanReversion(self.price, Config.ZSCORE_WINDOW, 
                                    Config.ZSCORE_ENTRY, Config.ZSCORE_EXIT)
        mr_signal = mr_strategy.generate_signal()
        self.signals['Mean_Reversion'] = self._format_signal(
            mr_signal,
            "Mean Reversion (Z-Score)",
            self._get_zscore_details()
        )
        
        # RSI Strategy
        rsi_strategy = RSIStrategy(self.price, Config.RSI_PERIOD, 
                                   Config.RSI_OVERSOLD, Config.RSI_OVERBOUGHT)
        rsi_signal = rsi_strategy.generate_signal()
        self.signals['RSI'] = self._format_signal(
            rsi_signal,
            "RSI Mean Reversion",
            self._get_rsi_details()
        )
        
        # Bollinger Bands Strategy
        bb_strategy = BollingerBandsStrategy(self.price, Config.BB_PERIOD, Config.BB_STD)
        bb_signal = bb_strategy.generate_signal()
        self.signals['Bollinger_Bands'] = self._format_signal(
            bb_signal,
            "Bollinger Bands",
            self._get_bb_details()
        )
        
        # Regime Detection
        detector = RegimeDetector(self.price, self.returns, Config.VOL_LOOKBACK, 
                                 Config.VOL_THRESHOLD, Config.REGIME_CONFIRM_DAYS)
        regime = detector.detect_regime()
        self.signals['Regime'] = self._format_regime(regime)
        
        return self.signals
    
    def _format_signal(self, signal: pd.Series, strategy_name: str, 
                      details: Dict) -> Dict:
        """Format signal output"""
        current_signal = signal.iloc[-1]
        previous_signal = signal.iloc[-2] if len(signal) > 1 else 0
        
        position = "LONG" if current_signal == 1 else "FLAT"
        action = "HOLD"
        
        if current_signal == 1 and previous_signal == 0:
            action = "BUY"
        elif current_signal == 0 and previous_signal == 1:
            action = "SELL"
        
        return {
            'strategy': strategy_name,
            'position': position,
            'action': action,
            'signal_value': int(current_signal),
            'details': details
        }
    
    def _format_regime(self, regime: pd.Series) -> Dict:
        """Format regime information"""
        current_regime = regime.iloc[-1]
        
        recommendation = {
            'Trend': "Favorable for trend-following and momentum strategies",
            'Choppy': "Favorable for mean reversion strategies",
            'Risk-Off': "Reduce exposure or stay in cash"
        }
        
        return {
            'strategy': 'Market Regime',
            'current_regime': current_regime,
            'recommendation': recommendation.get(current_regime, "Unknown"),
            'details': {
                'regime_type': current_regime,
                'volatility': self.returns.rolling(Config.VOL_LOOKBACK).std().iloc[-1] * np.sqrt(252)
            }
        }
    
    def _get_ma_details(self) -> Dict:
        """Get moving average details"""
        ma_fast = self.price.rolling(Config.MA_FAST).mean().iloc[-1]
        ma_slow = self.price.rolling(Config.MA_SLOW).mean().iloc[-1]
        
        return {
            'current_price': self.current_price,
            'ma_fast': ma_fast,
            'ma_slow': ma_slow,
            'distance_from_ma_fast': (self.current_price - ma_fast) / ma_fast,
            'distance_from_ma_slow': (self.current_price - ma_slow) / ma_slow
        }
    
    def _get_zscore_details(self) -> Dict:
        """Get z-score details"""
        zscore = compute_zscore(self.price, Config.ZSCORE_WINDOW).iloc[-1]
        mean = self.price.rolling(Config.ZSCORE_WINDOW).mean().iloc[-1]
        std = self.price.rolling(Config.ZSCORE_WINDOW).std().iloc[-1]
        
        return {
            'current_price': self.current_price,
            'zscore': zscore,
            'mean': mean,
            'std_dev': std,
            'interpretation': self._interpret_zscore(zscore)
        }
    
    def _get_rsi_details(self) -> Dict:
        """Get RSI details"""
        rsi = compute_rsi(self.price, Config.RSI_PERIOD).iloc[-1]
        
        return {
            'current_price': self.current_price,
            'rsi': rsi,
            'oversold_threshold': Config.RSI_OVERSOLD,
            'overbought_threshold': Config.RSI_OVERBOUGHT,
            'interpretation': self._interpret_rsi(rsi)
        }
    
    def _get_bb_details(self) -> Dict:
        """Get Bollinger Bands details"""
        upper, middle, lower = compute_bollinger_bands(self.price, Config.BB_PERIOD, Config.BB_STD)
        
        return {
            'current_price': self.current_price,
            'upper_band': upper.iloc[-1],
            'middle_band': middle.iloc[-1],
            'lower_band': lower.iloc[-1],
            'bb_width': (upper.iloc[-1] - lower.iloc[-1]) / middle.iloc[-1],
            'position_in_bands': (self.current_price - lower.iloc[-1]) / (upper.iloc[-1] - lower.iloc[-1])
        }
    
    def _interpret_zscore(self, zscore: float) -> str:
        """Interpret z-score value"""
        if zscore < -2:
            return "Extremely oversold"
        elif zscore < -1:
            return "Oversold"
        elif zscore > 2:
            return "Extremely overbought"
        elif zscore > 1:
            return "Overbought"
        else:
            return "Normal range"
    
    def _interpret_rsi(self, rsi: float) -> str:
        """Interpret RSI value"""
        if rsi < 30:
            return "Oversold"
        elif rsi > 70:
            return "Overbought"
        else:
            return "Neutral"
    
    def print_signals(self):
        """Print formatted trading signals"""
        print("\n" + "="*80)
        print(f"TRADING SIGNALS FOR {self.ticker}")
        print(f"Current Price: ${self.current_price:.2f}")
        print(f"As of: {self.price.index[-1].strftime('%Y-%m-%d')}")
        print("="*80)
        
        for signal_name, signal_data in self.signals.items():
