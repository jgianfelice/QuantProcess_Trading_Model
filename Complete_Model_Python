def run_factor_analysis(tickers: List[str], start_date: str,
                       end_date: Optional[str] = None,
                       include_value: bool = True,
                       method: str = 'long_only',
                       top_n: int = 5) -> Dict:
    """
    Run multi-factor analysis and portfolio construction

    Args:
        tickers: List of tickers to analyze
        start_date: Start date
        end_date: End date (optional)
        include_value: Whether to include value factor (needs fundamentals)
        method: 'long_only', 'long_short', or 'ranked'
        top_n: Number of top assets to hold

    Returns:
        Dictionary with results
    """
    print("\n" + "="*80)
    print("MULTI-FACTOR ANALYSIS")
    print("="*80)
    print(f"Assets: {', '.join(tickers)}")
    print(f"Factors: Momentum, Volatility" + (", Value" if include_value else ""))

    # Fetch price data
    print("\nFetching price data...")
    try:
        prices, returns = DataManager.fetch_data(tickers, start_date, end_date)
        print(f"Data loaded: {len(prices)} days")
    except Exception as e:
        print(f"Error fetching data: {e}")
        return {}

    # Fetch fundamentals if including value factor
    fundamentals = None
    if include_value:
        value_factor = ValueFactor()
        fundamentals = value_factor.fetch_fundamentals(tickers)

    # Create factor model
    factors = [
        MomentumFactor(lookback_periods=[21, 63, 126, 252]),
        VolatilityFactor(lookback_periods=[21, 63, 252])
    ]

    if include_value and fundamentals:
        factors.append(ValueFactor())

    model = MultiFactorModel(factors=factors)

    # Calculate factor scores
    factor_scores = model.calculate_factor_scores(prices, returns, fundamentals)

    # Print factor analysis
    model.print_factor_analysis()

    # Combine factors
    print("\nCombining factors...")
    combined_scores = model.combine_factors(method='equal_weight')

    # Generate portfolio
    print("\nGenerating portfolio...")
    if method == 'long_short_decile':
        weights = model.generate_portfolio_weights(
            combined_scores, method,
            long_allocation=1.0, short_allocation=1.0
        )
        # Print decile analysis
        model.print_decile_analysis()
    else:
        weights = model.generate_portfolio_weights(combined_scores, method, top_n)

    print(f"\n{'='*80}")
    print(f"FACTOR-BASED PORTFOLIO ({method.upper()})")
    print(f"{'='*80}")

    # Show long positions
    long_positions = weights[weights > 0].sort_values(ascending=False)
    if len(long_positions) > 0:
        print(f"\nLONG Positions ({len(long_positions)}):")

        for ticker, weight in long_positions.head(top_n if method != 'long_short_decile' else len(long_positions)).items():
            # Get factor scores for this ticker
            momentum = factor_scores.get('Momentum', pd.Series()).get(ticker, 0)
            volatility = factor_scores.get('Volatility', pd.Series()).get(ticker, 0)
            value = factor_scores.get('Value', pd.Series()).get(ticker, 0) if 'Value' in factor_scores else 0

            print(f"\n  {ticker}: {weight:.2%}")
            print(f"    Momentum: {momentum:>6.2f}")
            print(f"    Volatility: {volatility:>6.2f}")
            if include_value:
                print(f"    Value: {value:>6.2f}")
            print(f"    Combined: {combined_scores[ticker]:>6.2f}")

    # Show short positions if any
    short_positions = weights[weights < 0].sort_values()
    if len(short_positions) > 0:
        print(f"\nSHORT Positions ({len(short_positions)}):")

        for ticker, weight in short_positions.items():
            momentum = factor_scores.get('Momentum', pd.Series()).get(ticker, 0)
            volatility = factor_scores.get('Volatility', pd.Series()).get(ticker, 0)
            value = factor_scores.get('Value', pd.Series()).get(ticker, 0) if 'Value' in factor_scores else 0

            print(f"\n  {ticker}: {weight:.2%}")
            print(f"    Momentum: {momentum:>6.2f}")
            print(f"    Volatility: {volatility:>6.2f}")
            if include_value:
                print(f"    Value: {value:>6.2f}")
            print(f"    Combined: {combined_scores[ticker]:>6.2f}")

    # Backtest the portfolio
    print("\n" + "="*80)
    print("BACKTESTING FACTOR PORTFOLIO")
    print("="*80)

    portfolio_returns = (returns * weights).sum(axis=1)

    # Calculate performance
    metrics = PerformanceAnalytics.calculate_metrics(portfolio_returns)

    print(f"\nFactor Portfolio Performance:")
    print(f"  Total Return:    {metrics['total_return']:>10.2%}")
    print(f"  CAGR:            {metrics['cagr']:>10.2%}")
    print(f"  Sharpe Ratio:    {metrics['sharpe']:>10.2f}")
    print(f"  Max Drawdown:    {metrics['max_drawdown']:>10.2%}")
    print(f"  Win Rate:        {metrics['win_rate']:>10.2%}")

    # Compare to equal-weight
    equal_weight = pd.Series(1.0/len(tickers), index=returns.columns)
    equal_returns = (returns * equal_weight).sum(axis=1)
    equal_metrics = PerformanceAnalytics.calculate_metrics(equal_returns)

    print(f"\nEqual-Weight Benchmark:")
    print(f"  Total Return:    {equal_metrics['total_return']:>10.2%}")
    print(f"  CAGR:            {equal_metrics['cagr']:>10.2%}")
    print(f"  Sharpe Ratio:    {equal_metrics['sharpe']:>10.2f}")

    print(f"\nFactor Advantage:")
    print(f"  Sharpe Improvement: {metrics['sharpe'] - equal_metrics['sharpe']:+.2f}")
    print(f"  CAGR Improvement:   {(metrics['cagr'] - equal_metrics['cagr']):+.2%}")

    # Visualize
    import matplotlib.pyplot as plt
    import seaborn as sns

    fig, axes = plt.subplots(3, 1, figsize=(14, 10))

    # 1. Factor scores heatmap
    scores_df = pd.DataFrame(factor_scores)
    scores_df_sorted = scores_df.sort_values('Momentum', ascending=False)

    sns.heatmap(scores_df_sorted.T, annot=True, fmt='.2f', cmap='RdYlGn',
                center=0, ax=axes[0], cbar_kws={'label': 'Z-Score'})
    axes[0].set_title('Factor Scores by Asset', fontweight='bold')
    axes[0].set_xlabel('Asset')
    axes[0].set_ylabel('Factor')

    # 2. Cumulative returns comparison
    factor_equity = (1 + portfolio_returns).cumprod()
    equal_equity = (1 + equal_returns).cumprod()

    axes[1].plot(factor_equity.index, factor_equity.values,
                label='Factor Portfolio', linewidth=2)
    axes[1].plot(equal_equity.index, equal_equity.values,
                label='Equal Weight', linewidth=2, alpha=0.7)
    axes[1].set_ylabel('Cumulative Return')
    axes[1].set_title('Factor Portfolio vs Equal Weight', fontweight='bold')
    axes[1].legend()
    axes[1].grid(True, alpha=0.3)

    # 3. Portfolio weights
    weights_plot = weights[weights > 0].sort_values(ascending=True)
    weights_plot.plot(kind='barh', ax=axes[2], color='steelblue')
    axes[2].set_xlabel('Weight')
    axes[2].set_title(f'Factor Portfolio Allocation (Top {top_n})', fontweight='bold')
    axes[2].grid(True, alpha=0.3, axis='x')

    plt.tight_layout()
    plt.show()

    return {
        'model': model,
        'factor_scores': factor_scores,
        'combined_scores': combined_scores,
        'weights': weights,
        'portfolio_returns': portfolio_returns,
        'metrics': metrics
    }

