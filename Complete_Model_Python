class ParameterOptimizer:
    """Optimize strategy parameters systematically"""
    
    def __init__(self, price: pd.Series, returns: pd.Series):
        self.price = price
        self.returns = returns
        self.best_params = {}
    
    def optimize_ma_parameters(self, method: str = 'grid') -> Dict:
        """Optimize moving average parameters"""
        
        if method == 'grid':
            return self._grid_search_ma()
        else:
            return self._genetic_algorithm_ma()
    
    def _grid_search_ma(self) -> Dict:
        """Grid search for MA parameters"""
        fast_range = range(20, 101, 10)
        slow_range = range(100, 301, 20)
        
        best_sharpe = -np.inf
        best_params = {'fast': 50, 'slow': 200}
        
        for fast in fast_range:
            for slow in slow_range:
                if fast >= slow:
                    continue
                
                # Backtest with these parameters
                sharpe = self._backtest_ma(fast, slow)
                
                if sharpe > best_sharpe:
                    best_sharpe = sharpe
                    best_params = {'fast': fast, 'slow': slow}
        
        self.best_params['ma'] = best_params
        return best_params
    
    def _backtest_ma(self, fast: int, slow: int) -> float:
        """Backtest MA strategy and return Sharpe"""
        ma_fast = self.price.rolling(fast).mean()
        ma_slow = self.price.rolling(slow).mean()
        signal = (ma_fast > ma_slow).astype(int)
        
        trades = signal.diff().abs()
        strategy_returns = signal.shift(1) * self.returns
        strategy_returns -= trades * Config.TRANSACTION_COST
        
        strategy_returns = strategy_returns.dropna()
        
        if len(strategy_returns) == 0 or strategy_returns.std() == 0:
            return -np.inf
        
        sharpe = strategy_returns.mean() / strategy_returns.std() * np.sqrt(252)
        return sharpe
    
    def optimize_rsi_parameters(self) -> Dict:
        """Optimize RSI parameters"""
        period_range = range(10, 31, 2)
        oversold_range = range(20, 41, 5)
        overbought_range = range(60, 81, 5)
        
        best_sharpe = -np.inf
        best_params = {'period': 14, 'oversold': 30, 'overbought': 70}
        
        for period in period_range:
            for oversold in oversold_range:
                for overbought in overbought_range:
                    if oversold >= overbought:
                        continue
                    
                    sharpe = self._backtest_rsi(period, oversold, overbought)
                    
                    if sharpe > best_sharpe:
                        best_sharpe = sharpe
                        best_params = {
                            'period': period,
                            'oversold': oversold,
                            'overbought': overbought
                        }
        
        self.best_params['rsi'] = best_params
        return best_params
    
    def _backtest_rsi(self, period: int, oversold: float, overbought: float) -> float:
        """Backtest RSI strategy"""
        rsi = compute_rsi(self.price, period)
        
        signal = pd.Series(0, index=rsi.index)
        signal[rsi < oversold] = 1
        signal[rsi > overbought] = 0
        signal = signal.replace(0, np.nan).fillna(method='ffill').fillna(0)
        
        trades = signal.diff().abs()
        strategy_returns = signal.shift(1) * self.returns
        strategy_returns -= trades * Config.TRANSACTION_COST
        
        strategy_returns = strategy_returns.dropna()
        
        if len(strategy_returns) == 0 or strategy_returns.std() == 0:
            return -np.inf
        
        sharpe = strategy_returns.mean() / strategy_returns.std() * np.sqrt(252)
        return sharpe
    
    def optimize_all_strategies(self) -> Dict:
        """Optimize all strategy parameters"""
        print("Optimizing Moving Average parameters...")
        ma_params = self.optimize_ma_parameters()
        
        print("Optimizing RSI parameters...")
        rsi_params = self.optimize_rsi_parameters()
        
        return {
            'ma': ma_params,
            'rsi': rsi_params
        }

