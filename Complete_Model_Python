def run_regime_analysis(ticker: str, start_date: str, end_date: Optional[str] = None) -> Dict:
    """
    Run comprehensive market regime analysis

    Args:
        ticker: Ticker symbol
        start_date: Start date
        end_date: End date (optional)

    Returns:
        Dictionary with regime analysis results
    """
    print("\n" + "="*80)
    print(f"MARKET REGIME ANALYSIS - {ticker}")
    print("="*80)

    # Fetch data
    print(f"\nFetching data...")
    try:
        prices, returns = DataManager.fetch_data([ticker], start_date, end_date)
        price_series = prices[ticker] if isinstance(prices, pd.DataFrame) else prices
        return_series = returns[ticker] if isinstance(returns, pd.DataFrame) else returns

        print(f"Data loaded: {len(price_series)} days")
    except Exception as e:
        print(f"Error fetching data: {e}")
        return {}

    # Create regime detector
    detector = MarketRegimeDetector(
        price=price_series,
        returns=return_series,
        vol_lookback=20,
        trend_lookback=50,
        confirm_days=3
    )

    # Get regimes
    vol_regime = detector.detect_volatility_regime()
    trend_regime = detector.detect_trend_regime()
    combined_regime = detector.detect_combined_regime()

    # Current regime
    current = detector.get_current_regime()

    print("\n" + "="*80)
    print("CURRENT MARKET REGIME")
    print("="*80)
    print(f"Volatility Regime:  {current['volatility']}")
    print(f"Trend Regime:       {current['trend']}")
    print(f"Combined State:     {current['combined']}")
    print(f"\nKey Indicators:")
    print(f"  ADX (Trend Strength):    {current['adx']:.1f}")
    print(f"  Realized Volatility:     {current['realized_vol']:.1f}%")
    print(f"  R² (Trend Quality):      {current['r_squared']:.3f}")

    # Regime statistics
    stats = detector.get_regime_statistics()

    print("\n" + "="*80)
    print("REGIME DISTRIBUTION (Historical)")
    print("="*80)

    print("\nVolatility Regimes:")
    vol_stats = stats[['Volatility Regime', 'Volatility Regime %']].dropna()
    for idx, row in vol_stats.iterrows():
        print(f"  {idx:15s}: {row['Volatility Regime']:>4.0f} days ({row['Volatility Regime %']:>5.1f}%)")

    print("\nTrend Regimes:")
    trend_stats = stats[['Trend Regime', 'Trend Regime %']].dropna()
    for idx, row in trend_stats.iterrows():
        print(f"  {idx:15s}: {row['Trend Regime']:>4.0f} days ({row['Trend Regime %']:>5.1f}%)")

    print("\nCombined Market States:")
    combined_stats = stats[['Combined Regime', 'Combined Regime %']].dropna()
    for idx, row in combined_stats.iterrows():
        print(f"  {idx:20s}: {row['Combined Regime']:>4.0f} days ({row['Combined Regime %']:>5.1f}%)")

    # Trading recommendations by regime
    print("\n" + "="*80)
    print("TRADING RECOMMENDATIONS BY REGIME")
    print("="*80)

    regime_strategies = {
        'High Vol': {
            'description': 'High volatility period',
            'strategies': ['Reduce position sizes', 'Use wider stops', 'Consider options strategies'],
            'avoid': ['Tight stops', 'Leverage', 'Buy-and-hold without stops']
        },
        'Low Vol': {
            'description': 'Low volatility period',
            'strategies': ['Normal position sizes', 'Trend-following works well', 'Lower risk'],
            'avoid': ['Expecting big moves', 'Selling volatility naked']
        },
        'Trending': {
            'description': 'Strong directional movement',
            'strategies': ['Momentum strategies', 'Trend-following', 'Moving average crossovers'],
            'avoid': ['Mean-reversion', 'Range trading', 'Fading moves']
        },
        'Mean-Reverting': {
            'description': 'Oscillating around mean',
            'strategies': ['Mean-reversion strategies', 'RSI/Bollinger', 'Range trading'],
            'avoid': ['Momentum strategies', 'Breakout trading', 'Trend-following']
        }
    }

    current_vol = current['volatility']
    current_trend = current['trend']

    if current_vol in regime_strategies:
        strat = regime_strategies[current_vol]
        print(f"\nFor {current_vol}:")
        print(f"  {strat['description']}")
        print(f"  Best strategies:")
        for s in strat['strategies']:
            print(f"    ✓ {s}")
        print(f"  Avoid:")
        for a in strat['avoid']:
            print(f"    ✗ {a}")

    if current_trend in regime_strategies:
        strat = regime_strategies[current_trend]
        print(f"\nFor {current_trend}:")
        print(f"  {strat['description']}")
        print(f"  Best strategies:")
        for s in strat['strategies']:
            print(f"    ✓ {s}")
        print(f"  Avoid:")
        for a in strat['avoid']:
            print(f"    ✗ {a}")

    # Regime persistence analysis
    print("\n" + "="*80)
    print("REGIME PERSISTENCE ANALYSIS")
    print("="*80)

    # Calculate average regime duration
    def calculate_regime_durations(regime_series):
        durations = []
        current_regime = regime_series.iloc[0]
        duration = 1

        for i in range(1, len(regime_series)):
            if regime_series.iloc[i] == current_regime:
                duration += 1
            else:
                durations.append((current_regime, duration))
                current_regime = regime_series.iloc[i]
                duration = 1

        durations.append((current_regime, duration))

        # Group by regime type
        regime_durations = {}
        for regime, dur in durations:
            if regime not in regime_durations:
                regime_durations[regime] = []
            regime_durations[regime].append(dur)

        return {k: {'avg': np.mean(v), 'median': np.median(v), 'max': max(v)}
                for k, v in regime_durations.items()}

    vol_durations = calculate_regime_durations(vol_regime)
    trend_durations = calculate_regime_durations(trend_regime)

    print("\nAverage Regime Durations:")
    print("\nVolatility:")
    for regime, stats in vol_durations.items():
        print(f"  {regime:15s}: Avg {stats['avg']:>5.1f} days, Median {stats['median']:>5.1f}, Max {stats['max']:>5.0f}")

    print("\nTrend:")
    for regime, stats in trend_durations.items():
        print(f"  {regime:15s}: Avg {stats['avg']:>5.1f} days, Median {stats['median']:>5.1f}, Max {stats['max']:>5.0f}")

    # Plot comprehensive analysis
    print("\nGenerating regime analysis charts...")
    detector.plot_regime_analysis()

    return {
        'detector': detector,
        'volatility_regime': vol_regime,
        'trend_regime': trend_regime,
        'combined_regime': combined_regime,
        'current_regime': current,
        'statistics': stats,
        'durations': {
            'volatility': vol_durations,
            'trend': trend_durations
        }
    }

