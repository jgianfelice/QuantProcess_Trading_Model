    @staticmethod
    def plot_regime_overview(price: pd.Series, ma200: pd.Series,
                            regime: pd.Series):
        """Plot regime detection overview"""
        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 8), sharex=True)

        # Price and MA
        ax1.plot(price.index, price, label='Price', linewidth=1.5, alpha=0.8)
        ax1.plot(ma200.index, ma200, label='200 MA', linewidth=1.5,
