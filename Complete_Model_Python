class RegimeDetector:
    """Market regime detection using multiple signals"""
    
    def __init__(self, price: pd.Series, returns: pd.Series, 
                 vol_lookback: int = 20, vol_threshold: float = 0.20,
                 confirm_days: int = 5):
        self.price = price
        self.returns = returns
        self.vol_lookback = vol_lookback
        self.vol_threshold = vol_threshold
        self.confirm_days = confirm_days
    
    def detect_regime(self) -> pd.Series:
        """Detect market regime with hysteresis filter"""
        # Trend filter
        ma200 = self.price.rolling(200).mean()
        trend_regime = self.price > ma200
        
        # Volatility filter
        realized_vol = self.returns.rolling(self.vol_lookback).std() * np.sqrt(252)
        low_vol = realized_vol < self.vol_threshold
        
        # Raw regime classification
        raw_regime = pd.Series("Risk-Off", index=self.price.index)
        raw_regime[trend_regime & low_vol] = "Trend"
        raw_regime[trend_regime & ~low_vol] = "Choppy"
        
        # Apply hysteresis to reduce whipsaws
        return self._apply_hysteresis(raw_regime)
    
    def _apply_hysteresis(self, raw_regime: pd.Series) -> pd.Series:
        """Apply hysteresis filter to regime changes"""
        regime = raw_regime.copy()
        current = regime.iloc[0]
        count = 0
        
        for i in range(1, len(regime)):
            if raw_regime.iloc[i] == current:
                count = 0
            else:
                count += 1
                if count >= self.confirm_days:
                    current = raw_regime.iloc[i]
                    count = 0
            regime.iloc[i] = current
        
        return regime

