class RegimeAwareAllocator:
    """Allocate between strategies based on market regime"""
    
    def __init__(self, strategies: Dict[str, pd.Series], regime: pd.Series,
                 target_vol: float = 0.10):
        self.strategies = strategies
        self.regime = regime
        self.target_vol = target_vol
    
    def allocate(self) -> pd.Series:
        """Allocate between strategies based on regime"""
        combined = pd.DataFrame(self.strategies).dropna()
        regime_aligned = self.regime.reindex(combined.index)
        
        final_returns = pd.Series(0.0, index=combined.index)
        
        # Trend regime: favor trend following strategies
        trend_mask = regime_aligned == "Trend"
        if trend_mask.any():
            # Use MA if available, otherwise use any trend-following strategy
            if 'MA' in combined.columns:
                final_returns[trend_mask] = combined.loc[trend_mask, "MA"]
            elif 'MOM' in combined.columns:
                final_returns[trend_mask] = combined.loc[trend_mask, "MOM"]
            else:
                # Average all available strategies
                final_returns[trend_mask] = combined.loc[trend_mask].mean(axis=1)
        
        # Choppy regime: favor mean reversion strategies
        choppy_mask = regime_aligned == "Choppy"
        if choppy_mask.any():
            # Prefer mean reversion strategies
            mean_rev_strategies = []
            if 'Z' in combined.columns:
                mean_rev_strategies.append('Z')
            if 'RSI' in combined.columns:
                mean_rev_strategies.append('RSI')
            if 'BB' in combined.columns:
                mean_rev_strategies.append('BB')
            
            if mean_rev_strategies:
                final_returns[choppy_mask] = combined.loc[choppy_mask, mean_rev_strategies].mean(axis=1)
            else:
                # Use all available strategies
                final_returns[choppy_mask] = combined.loc[choppy_mask].mean(axis=1)
        
        # Risk-off regime: reduce exposure (stay flat)
        risk_off_mask = regime_aligned == "Risk-Off"
        final_returns[risk_off_mask] = 0.0
        
        # Apply volatility targeting
        return self._apply_vol_targeting(final_returns)
    
    def _apply_vol_targeting(self, returns: pd.Series) -> pd.Series:
        """Apply volatility targeting to final returns"""
        realized_vol = returns.rolling(20).std() * np.sqrt(252)
        scaler = safe_divide(
            pd.Series(self.target_vol, index=realized_vol.index),
            realized_vol
        ).clip(0, 1.5)
        
        return returns * scaler.shift(1)

