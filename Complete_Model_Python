class PerformanceAnalytics:
    """Comprehensive performance metrics calculation"""
    
    @staticmethod
    def calculate_metrics(returns: pd.Series) -> Dict[str, float]:
        """Calculate comprehensive performance metrics"""
        returns = returns.dropna()
        
        if len(returns) == 0 or returns.std() == 0:
            return PerformanceAnalytics._empty_metrics()
        
        equity = (1 + returns).cumprod()
        drawdown = (equity - equity.cummax()) / equity.cummax()
        
        # Core metrics
        total_return = equity.iloc[-1] - 1
        cagr = (equity.iloc[-1] ** (252 / len(returns))) - 1
        sharpe = returns.mean() / returns.std() * np.sqrt(252)
        
        # Risk metrics
        max_dd = drawdown.min()
        calmar = safe_divide(pd.Series([cagr]), pd.Series([abs(max_dd)]), 0).iloc[0]
        
        # Additional metrics
        sortino = PerformanceAnalytics._sortino_ratio(returns)
        win_rate = (returns > 0).sum() / len(returns)
        avg_win = returns[returns > 0].mean() if (returns > 0).any() else 0
        avg_loss = returns[returns < 0].mean() if (returns < 0).any() else 0
        profit_factor = abs(avg_win / avg_loss) if avg_loss != 0 else 0
        
        # Tail risk
        var_95 = returns.quantile(0.05)
        cvar_95 = returns[returns <= var_95].mean()
        
        return {
            'total_return': total_return,
            'cagr': cagr,
            'sharpe': sharpe,
            'sortino': sortino,
            'max_drawdown': max_dd,
            'calmar': calmar,
            'win_rate': win_rate,
            'profit_factor': profit_factor,
            'var_95': var_95,
            'cvar_95': cvar_95,
            'volatility': returns.std() * np.sqrt(252)
        }
    
    @staticmethod
    def _sortino_ratio(returns: pd.Series) -> float:
        """Calculate Sortino ratio (downside deviation)"""
        downside = returns[returns < 0].std()
        if downside == 0 or pd.isna(downside):
            return 0.0
        return returns.mean() / downside * np.sqrt(252)
    
    @staticmethod
    def _empty_metrics() -> Dict[str, float]:
        """Return empty metrics dict"""
        return {k: 0.0 for k in ['total_return', 'cagr', 'sharpe', 'sortino',
                                  'max_drawdown', 'calmar', 'win_rate', 
                                  'profit_factor', 'var_95', 'cvar_95', 'volatility']}
    
    @staticmethod
    def rolling_sharpe(returns: pd.Series, window: int) -> pd.Series:
        """Calculate rolling Sharpe ratio"""
        return safe_divide(
            returns.rolling(window).mean(),
            returns.rolling(window).std()
        ) * np.sqrt(252)
    
    @staticmethod
    def get_drawdown_series(returns: pd.Series) -> pd.Series:
        """Calculate drawdown series"""
        equity = (1 + returns).cumprod()
        return (equity - equity.cummax()) / equity.cummax()

