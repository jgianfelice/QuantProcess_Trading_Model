class MultiAssetPortfolioManager:
    """
    Comprehensive multi-asset portfolio management

    Features:
    - Equal weight vs volatility scaling
    - Dynamic rebalancing
    - Risk parity option
    - Drawdown-based position adjustment
    - Trailing stops on all positions
    """

    def __init__(self, tickers: List[str], initial_capital: float = 100000,
                 weighting_method: str = 'vol_scaled',
                 rebalance_frequency: str = 'monthly',
                 enable_trailing_stops: bool = True,
                 max_drawdown: float = 0.20):
        """
        Initialize multi-asset portfolio manager

        Args:
            tickers: List of ticker symbols
            initial_capital: Starting capital
            weighting_method: 'equal_weight', 'vol_scaled', 'risk_parity', or 'market_cap'
            rebalance_frequency: 'daily', 'weekly', 'monthly', 'quarterly'
            enable_trailing_stops: Enable trailing stops on positions
            max_drawdown: Maximum acceptable drawdown
        """
        self.tickers = tickers
        self.initial_capital = initial_capital
        self.weighting_method = weighting_method
        self.rebalance_frequency = rebalance_frequency

        # Create risk manager with trailing stops
        self.risk_manager = RiskManager(
            max_position_size=1.0 / len(tickers) * 2,  # Max 2x equal weight
            max_drawdown_limit=max_drawdown,
            enable_trailing_stop=enable_trailing_stops,
            trailing_stop_pct=0.10  # 10% trailing stop
        )

        # Create portfolio
        self.portfolio = Portfolio(
            initial_capital=initial_capital,
            risk_manager=self.risk_manager
        )

        # Track weights and rebalance dates
        self.current_weights = {}
        self.target_weights = {}
        self.last_rebalance = None
        self.rebalance_history = []

    def calculate_target_weights(self, prices: pd.DataFrame,
                                 returns: pd.DataFrame) -> Dict[str, float]:
        """
        Calculate target weights based on selected method

        Args:
            prices: DataFrame of prices
            returns: DataFrame of returns

        Returns:
            Dictionary of {ticker: weight}
        """
        n_assets = len(self.tickers)
        weights = {}

        if self.weighting_method == 'equal_weight':
            # Equal weight: 1/N for each asset
            for ticker in self.tickers:
                weights[ticker] = 1.0 / n_assets

        elif self.weighting_method == 'vol_scaled' or self.weighting_method == 'volatility_scaled':
            # Inverse volatility weighting
            # Calculate volatilities
            vols = {}
            for ticker in self.tickers:
                if ticker in returns.columns:
                    vol = returns[ticker].std() * np.sqrt(252)
                    vols[ticker] = max(vol, 0.01)  # Minimum vol
                else:
                    vols[ticker] = 0.20  # Default

            # Inverse volatility weights
            inv_vols = {t: 1.0/v for t, v in vols.items()}
            total_inv_vol = sum(inv_vols.values())

            for ticker in self.tickers:
                weights[ticker] = inv_vols[ticker] / total_inv_vol

        elif self.weighting_method == 'risk_parity':
            # Risk parity: equal risk contribution
            # Simplified version - equal weight adjusted by inverse volatility
            vols = {}
            for ticker in self.tickers:
                if ticker in returns.columns:
                    vol = returns[ticker].std() * np.sqrt(252)
                    vols[ticker] = max(vol, 0.01)
                else:
                    vols[ticker] = 0.20

            # Risk parity weights
            inv_vols = {t: 1.0/v for t, v in vols.items()}
            total_inv_vol = sum(inv_vols.values())

            for ticker in self.tickers:
                weights[ticker] = inv_vols[ticker] / total_inv_vol

        elif self.weighting_method == 'momentum':
            # Momentum-based weighting
            # Calculate 6-month returns
            lookback = min(126, len(returns))
            mom_scores = {}

            for ticker in self.tickers:
                if ticker in returns.columns and len(returns[ticker]) >= lookback:
                    # Total return over lookback period
                    mom = (1 + returns[ticker].tail(lookback)).prod() - 1
                    mom_scores[ticker] = max(mom, 0)  # Only positive momentum
                else:
                    mom_scores[ticker] = 0

            total_mom = sum(mom_scores.values())
            if total_mom > 0:
                for ticker in self.tickers:
                    weights[ticker] = mom_scores[ticker] / total_mom
            else:
                # Fallback to equal weight
                for ticker in self.tickers:
                    weights[ticker] = 1.0 / n_assets
        else:
            # Default to equal weight
            for ticker in self.tickers:
                weights[ticker] = 1.0 / n_assets

        # Ensure weights sum to 1
        total_weight = sum(weights.values())
        if total_weight > 0:
            weights = {t: w/total_weight for t, w in weights.items()}

        return weights

    def should_rebalance(self, current_date: datetime) -> bool:
        """Check if it's time to rebalance"""
        if self.last_rebalance is None:
            return True

        days_since = (current_date - self.last_rebalance).days

        if self.rebalance_frequency == 'daily':
            return days_since >= 1
        elif self.rebalance_frequency == 'weekly':
            return days_since >= 7
        elif self.rebalance_frequency == 'monthly':
            return days_since >= 30
        elif self.rebalance_frequency == 'quarterly':
            return days_since >= 90

        return False

    def rebalance_portfolio(self, date: datetime, prices: Dict[str, float],
                           returns: pd.DataFrame):
        """
        Rebalance portfolio to target weights

        Args:
            date: Current date
            prices: Current prices dictionary
            returns: Historical returns for weight calculation
        """
        # Calculate target weights
        prices_df = pd.DataFrame({t: [prices.get(t, np.nan)] for t in self.tickers})
        self.target_weights = self.calculate_target_weights(prices_df, returns)

        # Get current portfolio value
        portfolio_value = self.portfolio.get_portfolio_value(prices)

        # Calculate target dollar amounts
        target_values = {
            ticker: portfolio_value * weight
            for ticker, weight in self.target_weights.items()
        }

        # Close positions that should be reduced or eliminated
        for ticker, position in list(self.portfolio.positions.items()):
            current_value = position.market_value(prices[ticker])
            target_value = target_values.get(ticker, 0)

            if target_value < current_value * 0.9:  # Reduce if >10% off target
                # Close position (will re-open with correct size)
                self.portfolio.close_position(ticker, prices[ticker], date, reason='REBALANCE')

        # Open/adjust positions to target weights
        for ticker, target_weight in self.target_weights.items():
            if ticker not in prices or target_weight < 0.01:  # Skip tiny weights
                continue

            target_value = portfolio_value * target_weight

            if ticker not in self.portfolio.positions:
                # Open new position
                signal = 1  # Long only for now
                vol = returns[ticker].std() * np.sqrt(252) if ticker in returns.columns else 0.20

                # Override position sizing to use exact target weight
                self.portfolio.open_position(
                    ticker, signal, prices[ticker], date, vol,
                    position_sizing_method='equal_weight'  # Will be overridden
                )

                # Adjust the position to exact target weight
                if ticker in self.portfolio.positions:
                    pos = self.portfolio.positions[ticker]
                    current_val = pos.market_value(prices[ticker])
                    if abs(current_val - target_value) / portfolio_value > 0.01:
                        # Re-size if off by >1%
                        self.portfolio.close_position(ticker, prices[ticker], date, 'REBALANCE')
                        # Re-open with correct size (simplified - actual implementation would adjust quantity)

        self.last_rebalance = date
        self.rebalance_history.append({
            'date': date,
            'weights': self.target_weights.copy(),
            'portfolio_value': portfolio_value
        })

    def run_backtest(self, start_date: str, end_date: Optional[str] = None) -> Dict:
        """
        Run multi-asset backtest with rebalancing

        Returns:
            Dictionary with performance results
        """
        print(f"\nRunning multi-asset backtest: {', '.join(self.tickers)}")
        print(f"Weighting: {self.weighting_method}")
        print(f"Rebalance: {self.rebalance_frequency}")
        print(f"Trailing stops: {'Enabled' if self.risk_manager.enable_trailing_stop else 'Disabled'}")

        # Fetch data for all tickers
        prices, returns = DataManager.fetch_data(self.tickers, start_date, end_date)

        # Run backtest day by day
        for date in prices.index:
            # Get current prices
            current_prices = {
                ticker: prices.loc[date, ticker] if ticker in prices.columns else np.nan
                for ticker in self.tickers
            }

            # Remove NaN prices
            current_prices = {t: p for t, p in current_prices.items() if not np.isnan(p)}

            if not current_prices:
                continue

            # Update portfolio (checks stops)
            self.portfolio.update(date, current_prices)

            # Check if should rebalance
            if self.should_rebalance(date):
                # Get historical returns up to this point
                hist_returns = returns.loc[:date]
                if len(hist_returns) >= 20:  # Need minimum history
                    self.rebalance_portfolio(date, current_prices, hist_returns)

        # Get performance
        performance = self.portfolio.get_performance_summary()

        # Add multi-asset specific metrics
        performance['weighting_method'] = self.weighting_method
        performance['num_rebalances'] = len(self.rebalance_history)
        performance['tickers'] = self.tickers

        return performance

