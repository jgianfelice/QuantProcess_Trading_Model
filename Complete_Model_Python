class FeatureEngineer:
    """
    Advanced feature engineering for ML models

    Creates technical, fundamental, and derived features
    for predicting returns and trading signals
    """

    def __init__(self):
        self.feature_names = []

    def create_technical_features(self, price: pd.Series, returns: pd.Series,
                                  volume: Optional[pd.Series] = None) -> pd.DataFrame:
        """
        Create technical analysis features

        Returns:
            DataFrame with technical features
        """
        features = pd.DataFrame(index=price.index)

        # === PRICE FEATURES ===
        # Moving averages (multiple timeframes)
        for period in [5, 10, 20, 50, 100, 200]:
            features[f'ma_{period}'] = price.rolling(period).mean() / price - 1
            features[f'ma_{period}_slope'] = features[f'ma_{period}'].diff(5)

        # Price position in range
        for period in [5, 10, 20, 50]:
            high = price.rolling(period).max()
            low = price.rolling(period).min()
            features[f'price_position_{period}'] = (price - low) / (high - low + 1e-10)

        # === RETURN FEATURES ===
        # Returns at different horizons
        for period in [1, 2, 3, 5, 10, 20, 40, 60]:
            features[f'return_{period}d'] = returns.rolling(period).sum()

        # Return acceleration
        features['return_acceleration'] = returns.diff()

        # === VOLATILITY FEATURES ===
        # Historical volatility
        for period in [5, 10, 20, 40, 60]:
            features[f'volatility_{period}d'] = returns.rolling(period).std() * np.sqrt(252)

        # Volatility ratios (regime changes)
        features['vol_ratio_5_20'] = features['volatility_5d'] / (features['volatility_20d'] + 1e-10)
        features['vol_ratio_20_60'] = features['volatility_20d'] / (features['volatility_60d'] + 1e-10)

        # === MOMENTUM FEATURES ===
        # RSI
        features['rsi_14'] = self._compute_rsi(price, 14)
        features['rsi_28'] = self._compute_rsi(price, 28)

        # MACD
        ema_12 = price.ewm(span=12, adjust=False).mean()
        ema_26 = price.ewm(span=26, adjust=False).mean()
        features['macd'] = (ema_12 - ema_26) / price
        features['macd_signal'] = features['macd'].ewm(span=9, adjust=False).mean()
        features['macd_histogram'] = features['macd'] - features['macd_signal']

        # Momentum oscillators
        for period in [10, 20, 50]:
            features[f'momentum_{period}'] = price.pct_change(period)
            features[f'roc_{period}'] = (price - price.shift(period)) / price.shift(period)

        # === TREND FEATURES ===
        # ADX (Average Directional Index approximation)
        for period in [14, 28]:
            features[f'adx_{period}'] = self._compute_adx(price, period)

        # Trend strength
        features['trend_strength_20'] = abs(price.rolling(20).mean() - price) / price

        # === VOLATILITY INDICATORS ===
        # Bollinger Bands
        for period in [20, 50]:
            ma = price.rolling(period).mean()
            std = price.rolling(period).std()
            features[f'bb_upper_{period}'] = (ma + 2*std - price) / price
            features[f'bb_lower_{period}'] = (price - (ma - 2*std)) / price
            features[f'bb_width_{period}'] = (4 * std) / ma

        # ATR (Average True Range)
        features['atr_14'] = self._compute_atr(price, 14)

        # === VOLUME FEATURES (if available) ===
        if volume is not None:
            for period in [5, 10, 20]:
                features[f'volume_ma_{period}'] = volume.rolling(period).mean()
                features[f'volume_ratio_{period}'] = volume / features[f'volume_ma_{period}']

            # On-Balance Volume
            features['obv'] = self._compute_obv(price, volume)

        # === PATTERN FEATURES ===
        # Higher highs / lower lows
        features['higher_high_5'] = (price > price.rolling(5).max().shift(1)).astype(int)
        features['lower_low_5'] = (price < price.rolling(5).min().shift(1)).astype(int)

        # Gap detection
        features['gap_up'] = (price > price.shift(1) * 1.02).astype(int)
        features['gap_down'] = (price < price.shift(1) * 0.98).astype(int)

        self.feature_names = list(features.columns)
        return features

    def create_lagged_features(self, features: pd.DataFrame, lags: List[int] = [1, 2, 3, 5]) -> pd.DataFrame:
        """
        Create lagged versions of features

        Args:
            features: Base features
            lags: List of lag periods

        Returns:
            DataFrame with original + lagged features
        """
        lagged_features = features.copy()

        for lag in lags:
            for col in features.columns:
                lagged_features[f'{col}_lag{lag}'] = features[col].shift(lag)

        return lagged_features

    def create_interaction_features(self, features: pd.DataFrame,
                                    interactions: List[Tuple[str, str]] = None) -> pd.DataFrame:
        """
        Create interaction features (products of pairs)

        Args:
            features: Base features
            interactions: List of (feature1, feature2) tuples
                         If None, creates for important pairs

        Returns:
            DataFrame with interaction features added
        """
        result = features.copy()

        if interactions is None:
            # Default important interactions
            interactions = [
                ('return_5d', 'volatility_5d'),
                ('ma_20', 'rsi_14'),
                ('momentum_20', 'volatility_20d'),
                ('macd', 'rsi_14'),
            ]

        for feat1, feat2 in interactions:
            if feat1 in result.columns and feat2 in result.columns:
                result[f'{feat1}_x_{feat2}'] = result[feat1] * result[feat2]

        return result

    # Helper methods
    def _compute_rsi(self, price: pd.Series, period: int = 14) -> pd.Series:
        """Compute RSI indicator"""
        delta = price.diff()
        gain = (delta.where(delta > 0, 0)).rolling(period).mean()
        loss = (-delta.where(delta < 0, 0)).rolling(period).mean()
        rs = gain / (loss + 1e-10)
        return 100 - (100 / (1 + rs))

    def _compute_adx(self, price: pd.Series, period: int = 14) -> pd.Series:
        """Approximate ADX (simplified)"""
        high_low = price.rolling(period).max() - price.rolling(period).min()
        direction = price.diff().abs().rolling(period).mean()
        return (direction / (high_low + 1e-10) * 100).fillna(50)

    def _compute_atr(self, price: pd.Series, period: int = 14) -> pd.Series:
        """Approximate ATR"""
        high_low = price.rolling(period).max() - price.rolling(period).min()
        return (high_low / price).rolling(period).mean()

    def _compute_obv(self, price: pd.Series, volume: pd.Series) -> pd.Series:
        """Compute On-Balance Volume"""
        obv = (np.sign(price.diff()) * volume).fillna(0).cumsum()
        return obv

class LinearRegressionPredictor:
    """
    Linear Regression for return prediction

    Predicts future returns based on features
    Use for: Continuous return forecasting
    """

    def __init__(self, target_horizon: int = 5):
        """
        Args:
            target_horizon: Days ahead to predict (e.g., 5 = predict 5-day return)
        """
        from sklearn.linear_model import LinearRegression, Ridge

        self.model = Ridge(alpha=1.0)  # Ridge for regularization
        self.target_horizon = target_horizon
        self.scaler = StandardScaler()
        self.feature_engineer = FeatureEngineer()
        self.is_trained = False

    def prepare_features(self, price: pd.Series, returns: pd.Series,
                        volume: Optional[pd.Series] = None) -> pd.DataFrame:
        """Create and prepare features"""
        # Technical features
        features = self.feature_engineer.create_technical_features(price, returns, volume)

        # Lagged features
        features = self.feature_engineer.create_lagged_features(features, lags=[1, 2, 5])

        # Interaction features
        features = self.feature_engineer.create_interaction_features(features)

        return features.replace([np.inf, -np.inf], np.nan).fillna(0)

    def prepare_target(self, returns: pd.Series) -> pd.Series:
        """Prepare target variable (future returns)"""
        # Predict returns N days ahead
        target = returns.rolling(self.target_horizon).sum().shift(-self.target_horizon)
        return target

    def train(self, price: pd.Series, returns: pd.Series,
             volume: Optional[pd.Series] = None,
             test_size: float = 0.2) -> Dict[str, float]:
        """
        Train linear regression model

        Returns:
            Dictionary with training metrics
        """
        print(f"\nTraining Linear Regression (predicting {self.target_horizon}-day returns)...")

        # Prepare features and target
        X = self.prepare_features(price, returns, volume)
        y = self.prepare_target(returns)

        # Align and drop NaN
        data = pd.concat([X, y], axis=1).dropna()

        if len(data) < 100:
            print(f"  Insufficient data: {len(data)} samples (need 100+)")
            return {'r2': 0, 'mse': 0}

        X = data.iloc[:, :-1]
        y = data.iloc[:, -1]

        # Train/test split (time series, so use early data for train)
        split_idx = int(len(X) * (1 - test_size))
        X_train, X_test = X[:split_idx], X[split_idx:]
        y_train, y_test = y[:split_idx], y[split_idx:]

        # Scale features
        X_train_scaled = self.scaler.fit_transform(X_train)
        X_test_scaled = self.scaler.transform(X_test)

        # Train model
        self.model.fit(X_train_scaled, y_train)
        self.is_trained = True

        # Evaluate
        train_score = self.model.score(X_train_scaled, y_train)
        test_score = self.model.score(X_test_scaled, y_test)

        # Predictions
        y_pred = self.model.predict(X_test_scaled)
        mse = np.mean((y_test - y_pred) ** 2)

        print(f"  Training R²: {train_score:.4f}")
        print(f"  Test R²: {test_score:.4f}")
        print(f"  Test MSE: {mse:.6f}")

        # Feature importance
        feature_importance = pd.Series(
            np.abs(self.model.coef_),
            index=X.columns
        ).sort_values(ascending=False)

        print(f"\n  Top 5 Features:")
        for feat, importance in feature_importance.head(5).items():
            print(f"    {feat}: {importance:.4f}")

        return {
            'train_r2': train_score,
            'test_r2': test_score,
            'mse': mse,
            'feature_importance': feature_importance
        }

    def predict(self, price: pd.Series, returns: pd.Series,
               volume: Optional[pd.Series] = None) -> pd.Series:
        """
        Predict future returns

        Returns:
            Series of predicted returns
        """
        if not self.is_trained:
            raise ValueError("Model not trained. Call train() first.")

        # Prepare features
        X = self.prepare_features(price, returns, volume)
        X = X.replace([np.inf, -np.inf], np.nan).fillna(0)

        # Scale
        X_scaled = self.scaler.transform(X)

        # Predict
        predictions = self.model.predict(X_scaled)

        return pd.Series(predictions, index=X.index)

class LogisticRegressionPredictor:
    """
    Logistic Regression for directional prediction

    Predicts direction (up/down) instead of magnitude
    Use for: Binary classification trading signals
    """

    def __init__(self, target_horizon: int = 5, threshold: float = 0.0):
        """
        Args:
            target_horizon: Days ahead to predict
            threshold: Return threshold for positive class (e.g., 0.02 = 2%)
        """
        from sklearn.linear_model import LogisticRegression

        self.model = LogisticRegression(
            penalty='l2',
            C=1.0,
            max_iter=1000,
            class_weight='balanced'  # Handle imbalanced classes
        )
        self.target_horizon = target_horizon
        self.threshold = threshold
        self.scaler = StandardScaler()
        self.feature_engineer = FeatureEngineer()
        self.is_trained = False

    def prepare_features(self, price: pd.Series, returns: pd.Series,
                        volume: Optional[pd.Series] = None) -> pd.DataFrame:
        """Create and prepare features"""
        # Technical features
        features = self.feature_engineer.create_technical_features(price, returns, volume)

        # Lagged features
        features = self.feature_engineer.create_lagged_features(features, lags=[1, 2, 5])

        # Interaction features
        features = self.feature_engineer.create_interaction_features(features)

        return features.replace([np.inf, -np.inf], np.nan).fillna(0)

    def prepare_target(self, returns: pd.Series) -> pd.Series:
        """
        Prepare binary target (up=1, down=0)

        Returns:
            Series of 1s and 0s
        """
        # Future returns
        future_return = returns.rolling(self.target_horizon).sum().shift(-self.target_horizon)

        # Binary: 1 if return > threshold, 0 otherwise
        target = (future_return > self.threshold).astype(int)

        return target

    def train(self, price: pd.Series, returns: pd.Series,
             volume: Optional[pd.Series] = None,
             test_size: float = 0.2) -> Dict[str, float]:
        """
        Train logistic regression model

        Returns:
            Dictionary with training metrics
        """
        print(f"\nTraining Logistic Regression (predicting {self.target_horizon}-day direction)...")

        # Prepare features and target
        X = self.prepare_features(price, returns, volume)
        y = self.prepare_target(returns)

        # Align and drop NaN
        data = pd.concat([X, y], axis=1).dropna()

        if len(data) < 100:
            print(f"  Insufficient data: {len(data)} samples (need 100+)")
            return {'accuracy': 0, 'precision': 0, 'recall': 0}

        X = data.iloc[:, :-1]
        y = data.iloc[:, -1]

        # Train/test split
        split_idx = int(len(X) * (1 - test_size))
        X_train, X_test = X[:split_idx], X[split_idx:]
        y_train, y_test = y[:split_idx], y[split_idx:]

        print(f"  Training samples: {len(X_train)}")
        print(f"  Test samples: {len(X_test)}")
        print(f"  Positive class: {y_train.sum() / len(y_train):.2%}")

        # Scale features
        X_train_scaled = self.scaler.fit_transform(X_train)
        X_test_scaled = self.scaler.transform(X_test)

        # Train model
        self.model.fit(X_train_scaled, y_train)
        self.is_trained = True

        # Evaluate
        from sklearn.metrics import accuracy_score, precision_score, recall_score, roc_auc_score

        y_pred = self.model.predict(X_test_scaled)
        y_prob = self.model.predict_proba(X_test_scaled)[:, 1]

        accuracy = accuracy_score(y_test, y_pred)
        precision = precision_score(y_test, y_pred, zero_division=0)
        recall = recall_score(y_test, y_pred, zero_division=0)

        try:
            auc = roc_auc_score(y_test, y_prob)
        except:
            auc = 0.5

        print(f"  Test Accuracy: {accuracy:.4f}")
        print(f"  Test Precision: {precision:.4f}")
        print(f"  Test Recall: {recall:.4f}")
        print(f"  Test AUC-ROC: {auc:.4f}")

        # Feature importance
        feature_importance = pd.Series(
            np.abs(self.model.coef_[0]),
            index=X.columns
        ).sort_values(ascending=False)

        print(f"\n  Top 5 Features:")
        for feat, importance in feature_importance.head(5).items():
            print(f"    {feat}: {importance:.4f}")

        return {
            'accuracy': accuracy,
            'precision': precision,
            'recall': recall,
            'auc': auc,
            'feature_importance': feature_importance
        }

    def predict(self, price: pd.Series, returns: pd.Series,
               volume: Optional[pd.Series] = None,
               return_proba: bool = False) -> pd.Series:
        """
        Predict direction (up/down)

        Args:
            return_proba: If True, return probabilities instead of binary predictions

        Returns:
            Series of predictions (0/1) or probabilities
        """
        if not self.is_trained:
            raise ValueError("Model not trained. Call train() first.")

        # Prepare features
        X = self.prepare_features(price, returns, volume)
        X = X.replace([np.inf, -np.inf], np.nan).fillna(0)

        # Scale
        X_scaled = self.scaler.transform(X)

        # Predict
        if return_proba:
            predictions = self.model.predict_proba(X_scaled)[:, 1]
        else:
            predictions = self.model.predict(X_scaled)

        return pd.Series(predictions, index=X.index)

    def generate_signals(self, price: pd.Series, returns: pd.Series,
                        volume: Optional[pd.Series] = None,
                        confidence_threshold: float = 0.6) -> pd.Series:
        """
        Generate trading signals based on predictions

        Args:
            confidence_threshold: Minimum probability for signal (0.5-1.0)

        Returns:
            Series with signals: 1 (buy), 0 (hold), -1 (sell)
        """
        # Get probabilities
        probabilities = self.predict(price, returns, volume, return_proba=True)

        # Generate signals
        signals = pd.Series(0, index=probabilities.index)
        signals[probabilities >= confidence_threshold] = 1  # Buy
        signals[probabilities <= (1 - confidence_threshold)] = -1  # Sell

        return signals

