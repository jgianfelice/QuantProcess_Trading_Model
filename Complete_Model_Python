        ax1.set_title('Market Regime Detection', fontsize=13, fontweight='bold')
        ax1.legend(loc='upper left')
        ax1.grid(True, alpha=0.3)

        # Regime coloring
        regime_colors = {'Trend': 'green', 'Choppy': 'orange', 'Risk-Off': 'red'}
        for regime_type, color in regime_colors.items():
            mask = regime == regime_type
            ax2.fill_between(regime.index, 0, 1, where=mask,
