class AlertSystem:
    """Real-time alert system for trading signals"""
    
    def __init__(self):
        self.alerts = []
        self.alert_history = []
    
    def create_alert(self, ticker: str, signal: Signal, strategy: str,
                    price: float, confidence: float, timeframes_aligned: bool,
                    additional_info: Dict = None) -> Alert:
        """Create a new alert"""
        message = self._generate_alert_message(
            ticker, signal, strategy, price, confidence, 
            timeframes_aligned, additional_info
        )
        
        alert = Alert(
            timestamp=datetime.now(),
            ticker=ticker,
            signal=signal,
            strategy=strategy,
            price=price,
            confidence=confidence,
            message=message,
            timeframes_aligned=timeframes_aligned
        )
        
        self.alerts.append(alert)
        self.alert_history.append(alert)
        
        return alert
    
    def _generate_alert_message(self, ticker: str, signal: Signal, 
                                strategy: str, price: float, confidence: float,
                                timeframes_aligned: bool, 
                                additional_info: Dict = None) -> str:
        """Generate alert message"""
        alignment = "ALL TIMEFRAMES ALIGNED" if timeframes_aligned else "Single timeframe"
        
        message = f"""
TRADING ALERT - {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}

{ticker} - {signal.name.replace('_', ' ')}
Strategy: {strategy}
Current Price: ${price:.2f}
Confidence: {confidence:.1%}
Timeframe Alignment: {alignment}
"""
        
        if additional_info:
            message += "\nAdditional Information:\n"
            for key, value in additional_info.items():
                message += f"  {key}: {value}\n"
        
        return message
    
    def check_drawdown_alert(self, current_dd: float, ticker: str) -> Optional[Alert]:
        """Check if drawdown alert should be triggered"""
        if abs(current_dd) >= Config.DRAWDOWN_ALERT_THRESHOLD:
            return self.create_alert(
                ticker=ticker,
                signal=Signal.SELL,
                strategy="Risk Management",
                price=0.0,
                confidence=1.0,
                timeframes_aligned=False,
                additional_info={
                    'drawdown': f"{current_dd:.2%}",
                    'action': 'Consider reducing position size'
                }
            )
        return None
    
    def check_regime_change_alert(self, old_regime: str, new_regime: str,
                                  ticker: str) -> Optional[Alert]:
        """Alert on regime change"""
        if old_regime != new_regime:
            return self.create_alert(
                ticker=ticker,
                signal=Signal.HOLD,
                strategy="Regime Detection",
                price=0.0,
                confidence=1.0,
                timeframes_aligned=False,
                additional_info={
                    'old_regime': old_regime,
                    'new_regime': new_regime,
                    'recommendation': self._get_regime_recommendation(new_regime)
                }
            )
        return None
    
    def _get_regime_recommendation(self, regime: str) -> str:
        """Get recommendation based on regime"""
        recommendations = {
            'Trend': 'Favor momentum and trend-following strategies',
            'Choppy': 'Favor mean reversion strategies',
            'Risk-Off': 'Reduce exposure, consider defensive positions'
        }
        return recommendations.get(regime, 'Monitor closely')
    
    def get_active_alerts(self, min_confidence: float = 0.6) -> List[Alert]:
        """Get active high-confidence alerts"""
        return [a for a in self.alerts if a.confidence >= min_confidence]
    
    def print_alert(self, alert: Alert):
        """Print formatted alert"""
        print("\n" + "="*80)
        print(alert.message)
        print("="*80 + "\n")
    
    def clear_alerts(self):
        """Clear current alerts (keep history)"""
        self.alerts = []
    
    def export_alert_history(self, filename: str = 'alert_history.json'):
        """Export alert history to file"""
        export_data = [
            {
                'timestamp': a.timestamp.isoformat(),
                'ticker': a.ticker,
                'signal': a.signal.name,
                'strategy': a.strategy,
                'price': a.price,
                'confidence': a.confidence,
                'message': a.message
            }
            for a in self.alert_history
        ]
        
        with open(filename, 'w') as f:
            json.dump(export_data, f, indent=2)

