class MonteCarloSimulator:
    """Monte Carlo simulation for strategy robustness testing"""

    def __init__(self, returns: pd.Series, n_simulations: int = 1000,
                 sample_size: int = 252):
        self.returns = returns.dropna()
        self.n_simulations = n_simulations
        self.sample_size = sample_size

    def run(self) -> pd.DataFrame:
        """Run Monte Carlo simulation using bootstrap resampling"""
        simulated_returns = []

        for _ in range(self.n_simulations):
            sample = np.random.choice(
                self.returns.values,
                size=self.sample_size,
                replace=True
            )
            simulated_returns.append(sample)

        return pd.DataFrame(simulated_returns).T

    def get_metrics(self) -> Dict[str, float]:
        """Calculate Monte Carlo statistics"""
        sims = self.run()
        equity_curves = (1 + sims).cumprod()
        final_values = equity_curves.iloc[-1]

        sharpe_ratios = []
        for col in sims.columns:
            ret = sims[col]
            if ret.std() > 0:
                sharpe_ratios.append(ret.mean() / ret.std() * np.sqrt(252))

        return {
            'mean_return': final_values.mean() - 1,
            'median_return': final_values.median() - 1,
            'std_return': final_values.std(),
            'percentile_5': final_values.quantile(0.05) - 1,
            'percentile_95': final_values.quantile(0.95) - 1,
            'mean_sharpe': np.mean(sharpe_ratios) if sharpe_ratios else 0,
            'median_sharpe': np.median(sharpe_ratios) if sharpe_ratios else 0
        }

