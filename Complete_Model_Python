class MarketRegimeDetector:
    """
    Advanced market regime detection system

    Detects:
    1. Volatility regimes (High/Low)
    2. Trend regimes (Trending/Mean-Reverting)
    3. Combined market states

    Uses multiple indicators for robust classification
    """

    def __init__(self, price: pd.Series, returns: pd.Series,
                 vol_lookback: int = 20,
                 trend_lookback: int = 50,
                 confirm_days: int = 3):
        """
        Args:
            price: Price series
            returns: Returns series
            vol_lookback: Period for volatility calculation
            trend_lookback: Period for trend detection
            confirm_days: Days to confirm regime change (reduces whipsaws)
        """
        self.price = price
        self.returns = returns
        self.vol_lookback = vol_lookback
        self.trend_lookback = trend_lookback
        self.confirm_days = confirm_days

        # Pre-calculate indicators
        self._calculate_indicators()

    def _calculate_indicators(self):
        """Pre-calculate all regime indicators"""
        # Volatility measures
        self.realized_vol = self.returns.rolling(self.vol_lookback).std() * np.sqrt(252)
        self.vol_percentile = self.realized_vol.rolling(252).rank(pct=True)

        # Trend measures
        self.sma_50 = self.price.rolling(50).mean()
        self.sma_200 = self.price.rolling(200).mean()
        self.price_to_ma = self.price / self.sma_50

        # ADX for trend strength
        self.adx = self._calculate_adx(self.price, period=14)

        # ATR for volatility
        self.atr = self._calculate_atr(self.price, period=14)

        # R-squared for trend quality
        self.r_squared = self._calculate_r_squared(self.price, period=self.trend_lookback)

    def _calculate_adx(self, price: pd.Series, period: int = 14) -> pd.Series:
        """Calculate Average Directional Index (ADX) - trend strength"""
        high = price.rolling(period).max()
        low = price.rolling(period).min()

        # Simplified ADX
        tr = high - low
        directional_movement = price.diff().abs()

        adx = (directional_movement.rolling(period).mean() /
               (tr.rolling(period).mean() + 1e-10) * 100)

        return adx.fillna(25)  # Neutral value

    def _calculate_atr(self, price: pd.Series, period: int = 14) -> pd.Series:
        """Calculate Average True Range (ATR)"""
        high = price.rolling(period).max()
        low = price.rolling(period).min()
        tr = high - low
        atr = tr.rolling(period).mean()
        return atr / price  # Normalized ATR

    def _calculate_r_squared(self, price: pd.Series, period: int = 50) -> pd.Series:
        """
        Calculate R-squared of linear regression
        Measures how well price follows a linear trend

        High R² = Strong trend
        Low R² = Mean-reverting/choppy
        """
        def rolling_r_squared(x):
            if len(x) < 10:
                return 0.5

            y = x.values
            n = len(y)
            x_vals = np.arange(n)

            # Linear regression
            x_mean = x_vals.mean()
            y_mean = y.mean()

            numerator = ((x_vals - x_mean) * (y - y_mean)).sum()
            denominator = np.sqrt(((x_vals - x_mean)**2).sum() * ((y - y_mean)**2).sum())

            if denominator == 0:
                return 0.5

            r = numerator / denominator
            return r ** 2

        r_squared = price.rolling(period).apply(rolling_r_squared, raw=False)
        return r_squared.fillna(0.5)

    def detect_volatility_regime(self) -> pd.Series:
        """
        Detect volatility regime: High or Low

        Uses:
        - Realized volatility percentile
        - ATR

        Returns:
            Series with 'High Vol' or 'Low Vol'
        """
        # Multiple volatility signals
        vol_high_percentile = self.vol_percentile > 0.7  # Top 30%
        vol_low_percentile = self.vol_percentile < 0.3   # Bottom 30%

        atr_high = self.atr > self.atr.rolling(100).median()

        # Classify
        regime = pd.Series('Medium Vol', index=self.price.index)
        regime[vol_high_percentile | atr_high] = 'High Vol'
        regime[vol_low_percentile & ~atr_high] = 'Low Vol'

        # Apply confirmation filter
        return self._apply_hysteresis(regime)

    def detect_trend_regime(self) -> pd.Series:
        """
        Detect trend regime: Trending or Mean-Reverting

        Uses:
        - ADX (trend strength)
        - R-squared (trend quality)
        - Moving average alignment

        Returns:
            Series with 'Trending' or 'Mean-Reverting'
        """
        # Multiple trend signals
        adx_trending = self.adx > 25  # Standard ADX threshold
        r_squared_high = self.r_squared > 0.6  # Strong linear relationship

        # MA alignment
        ma_aligned = (self.price > self.sma_50) & (self.sma_50 > self.sma_200)
        ma_diverging = ~ma_aligned & ~((self.price < self.sma_50) & (self.sma_50 < self.sma_200))

        # Price deviation from MA (mean reversion signal)
        price_deviation = abs(self.price / self.sma_50 - 1)
        extreme_deviation = price_deviation > 0.05  # 5% from MA

        # Classify
        regime = pd.Series('Choppy', index=self.price.index)

        # Trending: High ADX + High R² OR strong MA alignment
        trending = (adx_trending & r_squared_high) | (ma_aligned & (self.adx > 20))
        regime[trending] = 'Trending'

        # Mean-reverting: Low ADX + Low R² + extreme deviations
        mean_reverting = (~adx_trending & (self.r_squared < 0.4)) | extreme_deviation
        regime[mean_reverting] = 'Mean-Reverting'

        # Apply confirmation filter
        return self._apply_hysteresis(regime)

    def detect_combined_regime(self) -> pd.Series:
        """
        Detect combined market regime

        Combines volatility and trend regimes into market states:
        - Low Vol + Trending = 'Steady Trend'
        - Low Vol + Mean-Reverting = 'Quiet Range'
        - High Vol + Trending = 'Volatile Trend'
        - High Vol + Mean-Reverting = 'Choppy Market'

        Returns:
            Series with combined regime labels
        """
        vol_regime = self.detect_volatility_regime()
        trend_regime = self.detect_trend_regime()

        # Combine regimes
        combined = pd.Series('Unknown', index=self.price.index)

        for i in range(len(combined)):
            vol = vol_regime.iloc[i]
            trend = trend_regime.iloc[i]

            if vol == 'Low Vol':
                if trend == 'Trending':
                    combined.iloc[i] = 'Steady Trend'
                elif trend == 'Mean-Reverting':
                    combined.iloc[i] = 'Quiet Range'
                else:
                    combined.iloc[i] = 'Low Vol Choppy'

            elif vol == 'High Vol':
                if trend == 'Trending':
                    combined.iloc[i] = 'Volatile Trend'
                elif trend == 'Mean-Reverting':
                    combined.iloc[i] = 'Choppy Market'
                else:
                    combined.iloc[i] = 'High Vol Choppy'

            else:  # Medium Vol
                if trend == 'Trending':
                    combined.iloc[i] = 'Normal Trend'
                elif trend == 'Mean-Reverting':
                    combined.iloc[i] = 'Normal Range'
                else:
                    combined.iloc[i] = 'Neutral'

        return combined

    def _apply_hysteresis(self, raw_regime: pd.Series) -> pd.Series:
        """
        Apply hysteresis filter to reduce regime switching noise

        Requires regime to persist for confirm_days before switching
        """
        regime = raw_regime.copy()
        current = regime.iloc[0]
        count = 0

        for i in range(1, len(regime)):
            if raw_regime.iloc[i] == current:
                count = 0
            else:
                count += 1
                if count >= self.confirm_days:
                    current = raw_regime.iloc[i]
                    count = 0
            regime.iloc[i] = current

        return regime

    def get_regime_statistics(self) -> pd.DataFrame:
        """
        Get statistics about regime distribution

        Returns:
            DataFrame with regime counts, durations, and percentages
        """
        vol_regime = self.detect_volatility_regime()
        trend_regime = self.detect_trend_regime()
        combined_regime = self.detect_combined_regime()

        stats = pd.DataFrame({
            'Volatility Regime': vol_regime.value_counts(),
            'Trend Regime': trend_regime.value_counts(),
            'Combined Regime': combined_regime.value_counts()
        }).fillna(0)

        # Add percentages
        for col in stats.columns:
            stats[f'{col} %'] = stats[col] / len(vol_regime) * 100

        return stats

    def get_current_regime(self) -> Dict[str, str]:
        """Get the most recent regime classification"""
        vol_regime = self.detect_volatility_regime()
        trend_regime = self.detect_trend_regime()
        combined_regime = self.detect_combined_regime()

        return {
            'volatility': vol_regime.iloc[-1],
            'trend': trend_regime.iloc[-1],
            'combined': combined_regime.iloc[-1],
            'adx': self.adx.iloc[-1],
            'realized_vol': self.realized_vol.iloc[-1] * 100,
            'r_squared': self.r_squared.iloc[-1]
        }

    def plot_regime_analysis(self):
        """Plot comprehensive regime analysis"""
        import matplotlib.pyplot as plt

        vol_regime = self.detect_volatility_regime()
        trend_regime = self.detect_trend_regime()
        combined_regime = self.detect_combined_regime()

        fig, axes = plt.subplots(5, 1, figsize=(14, 12), sharex=True)

        # 1. Price with regimes
        axes[0].plot(self.price.index, self.price.values, linewidth=1, color='black')
        axes[0].plot(self.sma_50.index, self.sma_50.values, linewidth=1,
                    alpha=0.7, label='SMA 50', color='blue')
        axes[0].plot(self.sma_200.index, self.sma_200.values, linewidth=1,
                    alpha=0.7, label='SMA 200', color='red')
        axes[0].set_ylabel('Price')
        axes[0].set_title('Market Regime Analysis', fontweight='bold', fontsize=14)
        axes[0].legend()
        axes[0].grid(True, alpha=0.3)

        # 2. Volatility regime
        vol_colors = {'High Vol': 'red', 'Medium Vol': 'orange', 'Low Vol': 'green'}
        for regime_type in vol_colors:
            mask = vol_regime == regime_type
            if mask.any():
                axes[1].fill_between(self.price.index, 0, 1, where=mask,
                                    alpha=0.3, label=regime_type, color=vol_colors[regime_type])

        axes[1].plot(self.realized_vol.index, self.realized_vol.values * 100,
                    linewidth=1, color='black', label='Realized Vol %')
        axes[1].set_ylabel('Volatility (%)')
        axes[1].set_title('Volatility Regime', fontweight='bold')
        axes[1].legend(loc='upper left')
        axes[1].grid(True, alpha=0.3)

        # 3. Trend regime
        trend_colors = {'Trending': 'green', 'Mean-Reverting': 'red', 'Choppy': 'orange'}
        for regime_type in trend_colors:
            mask = trend_regime == regime_type
            if mask.any():
                axes[2].fill_between(self.price.index, 0, 1, where=mask,
                                    alpha=0.3, label=regime_type, color=trend_colors[regime_type])

        axes[2].plot(self.adx.index, self.adx.values, linewidth=1,
                    color='black', label='ADX')
        axes[2].axhline(y=25, color='gray', linestyle='--', alpha=0.5)
        axes[2].set_ylabel('ADX')
        axes[2].set_title('Trend Regime', fontweight='bold')
        axes[2].legend(loc='upper left')
        axes[2].grid(True, alpha=0.3)

        # 4. R-squared (trend quality)
        axes[3].plot(self.r_squared.index, self.r_squared.values,
                    linewidth=1, color='purple', label='R²')
        axes[3].axhline(y=0.6, color='green', linestyle='--', alpha=0.5, label='Strong Trend')
        axes[3].axhline(y=0.4, color='red', linestyle='--', alpha=0.5, label='Weak Trend')
        axes[3].set_ylabel('R²')
        axes[3].set_title('Trend Quality (R-squared)', fontweight='bold')
        axes[3].set_ylim([0, 1])
        axes[3].legend()
        axes[3].grid(True, alpha=0.3)

        # 5. Combined regime timeline
        # Create numeric encoding for visualization
        regime_map = {
            'Steady Trend': 5, 'Normal Trend': 4, 'Volatile Trend': 3,
            'Quiet Range': 2, 'Normal Range': 1, 'Choppy Market': 0,
            'Low Vol Choppy': 1.5, 'High Vol Choppy': 0.5, 'Neutral': 2.5
        }

        regime_numeric = combined_regime.map(regime_map)

        # Use step plot for clear regime boundaries
        axes[4].step(regime_numeric.index, regime_numeric.values,
                    where='post', linewidth=2, color='darkblue')
        axes[4].set_ylabel('Regime')
        axes[4].set_xlabel('Date')
        axes[4].set_title('Combined Market Regime', fontweight='bold')
        axes[4].set_yticks([0, 1, 2, 3, 4, 5])
        axes[4].set_yticklabels(['Choppy', 'Range', 'Quiet', 'Vol Trend', 'Normal', 'Steady'])
        axes[4].grid(True, alpha=0.3)

        plt.tight_layout()
        plt.show()

