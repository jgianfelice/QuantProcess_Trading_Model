def run_ml_analysis(ticker: str, start_date: str, end_date: Optional[str] = None,
                   target_horizon: int = 5, model_type: str = 'both') -> Dict:
    """
    Run machine learning analysis

    Args:
        ticker: Ticker symbol
        start_date: Start date
        end_date: End date (optional)
        target_horizon: Days ahead to predict
        model_type: 'linear', 'logistic', or 'both'

    Returns:
        Dictionary with model results
    """
    print("\n" + "="*80)
    print(f"MACHINE LEARNING ANALYSIS - {ticker}")
    print("="*80)
    print(f"Target Horizon: {target_horizon} days")
    print(f"Model Type: {model_type}")

    # Fetch data
    print(f"\nFetching data...")
    try:
        prices, returns = DataManager.fetch_data([ticker], start_date, end_date)
        price_series = prices[ticker] if isinstance(prices, pd.DataFrame) else prices
        return_series = returns[ticker] if isinstance(returns, pd.DataFrame) else returns

        print(f"Data loaded: {len(price_series)} days")
    except Exception as e:
        print(f"Error fetching data: {e}")
        return {}

    results = {}

    # Linear Regression
    if model_type in ['linear', 'both']:
        print("\n" + "="*80)
        print("LINEAR REGRESSION - Predicting Return Magnitude")
        print("="*80)

        lr_model = LinearRegressionPredictor(target_horizon=target_horizon)
        lr_metrics = lr_model.train(price_series, return_series)

        if lr_metrics['test_r2'] > 0:
            # Get predictions
            predictions = lr_model.predict(price_series, return_series)

            # Generate signals from predictions
            signals = pd.Series(0, index=predictions.index)
            signals[predictions > 0.01] = 1  # Buy if predicted return > 1%
            signals[predictions < -0.01] = -1  # Sell if predicted return < -1%

            # Backtest
            strategy_returns = signals.shift(1) * return_series
            strategy_returns = strategy_returns.dropna()

            if len(strategy_returns) > 0:
                strategy_metrics = PerformanceAnalytics.calculate_metrics(strategy_returns)

                print(f"\nLinear Regression Strategy Performance:")
                print(f"  Sharpe Ratio: {strategy_metrics['sharpe']:.2f}")
                print(f"  Total Return: {strategy_metrics['total_return']:.2%}")
                print(f"  Win Rate: {strategy_metrics['win_rate']:.2%}")

                results['linear'] = {
                    'model': lr_model,
                    'metrics': lr_metrics,
                    'predictions': predictions,
                    'signals': signals,
                    'strategy_returns': strategy_returns,
                    'strategy_metrics': strategy_metrics
                }

    # Logistic Regression
    if model_type in ['logistic', 'both']:
        print("\n" + "="*80)
        print("LOGISTIC REGRESSION - Predicting Direction")
        print("="*80)

        log_model = LogisticRegressionPredictor(target_horizon=target_horizon, threshold=0.0)
        log_metrics = log_model.train(price_series, return_series)

        if log_metrics['accuracy'] > 0:
            # Generate signals with confidence threshold
            signals = log_model.generate_signals(
                price_series, return_series,
                confidence_threshold=0.6
            )

            # Backtest
            strategy_returns = signals.shift(1) * return_series
            strategy_returns = strategy_returns.dropna()

            if len(strategy_returns) > 0:
                strategy_metrics = PerformanceAnalytics.calculate_metrics(strategy_returns)

                print(f"\nLogistic Regression Strategy Performance:")
                print(f"  Sharpe Ratio: {strategy_metrics['sharpe']:.2f}")
                print(f"  Total Return: {strategy_metrics['total_return']:.2%}")
                print(f"  Win Rate: {strategy_metrics['win_rate']:.2%}")

                results['logistic'] = {
                    'model': log_model,
                    'metrics': log_metrics,
                    'signals': signals,
                    'strategy_returns': strategy_returns,
                    'strategy_metrics': strategy_metrics
                }

    # Comparison
    if len(results) == 2:
        print("\n" + "="*80)
        print("MODEL COMPARISON")
        print("="*80)

        comparison = pd.DataFrame({
            'Linear Reg': results['linear']['strategy_metrics'],
            'Logistic Reg': results['logistic']['strategy_metrics']
        }).T

        print("\nKey Metrics:")
        print(comparison[['total_return', 'sharpe', 'max_drawdown', 'win_rate']])

    # Visualization
    if results:
        import matplotlib.pyplot as plt

        n_plots = len(results)
        fig, axes = plt.subplots(n_plots, 1, figsize=(14, 5*n_plots))

        if n_plots == 1:
            axes = [axes]

        plot_idx = 0

        if 'linear' in results:
            lr_data = results['linear']
            equity = (1 + lr_data['strategy_returns']).cumprod()
            bh_equity = (1 + return_series.loc[equity.index]).cumprod()

            axes[plot_idx].plot(equity.index, equity.values,
                               label='Linear Regression Strategy', linewidth=2)
            axes[plot_idx].plot(bh_equity.index, bh_equity.values,
                               label='Buy & Hold', linewidth=2, alpha=0.7)
            axes[plot_idx].set_title('Linear Regression - Return Prediction', fontweight='bold')
            axes[plot_idx].set_ylabel('Cumulative Return')
            axes[plot_idx].legend()
            axes[plot_idx].grid(True, alpha=0.3)
            plot_idx += 1

        if 'logistic' in results:
            log_data = results['logistic']
            equity = (1 + log_data['strategy_returns']).cumprod()
            bh_equity = (1 + return_series.loc[equity.index]).cumprod()

            axes[plot_idx].plot(equity.index, equity.values,
                               label='Logistic Regression Strategy', linewidth=2)
            axes[plot_idx].plot(bh_equity.index, bh_equity.values,
                               label='Buy & Hold', linewidth=2, alpha=0.7)
            axes[plot_idx].set_title('Logistic Regression - Direction Prediction', fontweight='bold')
            axes[plot_idx].set_ylabel('Cumulative Return')
            axes[plot_idx].set_xlabel('Date')
            axes[plot_idx].legend()
            axes[plot_idx].grid(True, alpha=0.3)

        plt.tight_layout()
        plt.show()

    return results

