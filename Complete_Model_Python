def run_multi_asset_backtest(tickers: List[str], start_date: str,
                             end_date: Optional[str] = None,
                             weighting_method: str = 'vol_scaled',
                             initial_capital: float = 100000) -> Dict:
    """
    Run comprehensive multi-asset portfolio backtest

    Args:
        tickers: List of ticker symbols
        start_date: Start date
        end_date: End date (optional)
        weighting_method: 'equal_weight', 'vol_scaled', 'risk_parity', or 'momentum'
        initial_capital: Starting capital

    Returns:
        Performance dictionary
    """
    print("\n" + "="*80)
    print("MULTI-ASSET PORTFOLIO BACKTEST")
    print("="*80)

    # Display weighting method info
    method_descriptions = {
        'equal_weight': 'Equal Weight (1/N allocation)',
        'vol_scaled': 'Volatility Scaled (inverse volatility weighting)',
        'risk_parity': 'Risk Parity (equal risk contribution)',
        'momentum': 'Momentum Weighted (favors recent winners)'
    }

    print(f"\nStrategy: {method_descriptions.get(weighting_method, weighting_method)}")
    print(f"Assets: {', '.join(tickers)}")
    print(f"Initial Capital: ${initial_capital:,.0f}")

    # Create manager
    manager = MultiAssetPortfolioManager(
        tickers=tickers,
        initial_capital=initial_capital,
        weighting_method=weighting_method,
        rebalance_frequency='monthly',
        enable_trailing_stops=True,
        max_drawdown=0.20
    )

    # Run backtest
    performance = manager.run_backtest(start_date, end_date)

    # Print results
    manager.print_performance_summary(performance)

    # Visualize
    if manager.portfolio.equity_curve:
        equity_df = pd.DataFrame(manager.portfolio.equity_curve)
        equity_df.set_index('date', inplace=True)

        fig, axes = plt.subplots(3, 1, figsize=(14, 10), sharex=True)

        # Equity curve
        axes[0].plot(equity_df.index, equity_df['value'], linewidth=2, label='Portfolio Value')
        axes[0].axhline(y=initial_capital, color='gray', linestyle='--', alpha=0.5, label='Initial')
        axes[0].set_ylabel('Portfolio Value ($)')
        axes[0].set_title(f'Multi-Asset Portfolio ({weighting_method})', fontweight='bold')
        axes[0].legend()
        axes[0].grid(True, alpha=0.3)

        # Drawdown
        peak = equity_df['value'].cummax()
        drawdown = (equity_df['value'] - peak) / peak * 100
        axes[1].fill_between(equity_df.index, 0, drawdown, alpha=0.3, color='red')
        axes[1].plot(equity_df.index, drawdown, color='red', linewidth=1)
        axes[1].set_ylabel('Drawdown (%)')
        axes[1].grid(True, alpha=0.3)

        # Asset allocation over time (from rebalance history)
        if manager.rebalance_history:
            rebal_df = pd.DataFrame(manager.rebalance_history)
            rebal_df.set_index('date', inplace=True)

            # Extract weights into separate columns
            weight_data = {}
            for ticker in tickers:
