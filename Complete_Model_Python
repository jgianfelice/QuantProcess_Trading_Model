class Strategy:
    """Base strategy class"""

    @staticmethod
    def apply_transaction_costs(returns: pd.Series, signal: pd.Series,
                                cost: float = 0.001) -> pd.Series:
        """Apply transaction costs to strategy returns"""
        trades = signal.diff().abs()
        adjusted_returns = signal.shift(1) * returns
        adjusted_returns -= trades * cost
        return adjusted_returns.dropna()

class MovingAverageTrend(Strategy):
    """Moving Average trend following strategy"""

    def __init__(self, price: pd.Series, fast: int = 50, slow: int = 200):
        self.price = price
        self.fast = fast
        self.slow = slow

    def generate_signal(self) -> pd.Series:
        """Generate MA crossover signal"""
        ma_fast = self.price.rolling(self.fast).mean()
        ma_slow = self.price.rolling(self.slow).mean()
        return (ma_fast > ma_slow).astype(int)

    def backtest(self, returns: pd.Series, cost: float = 0.001) -> pd.Series:
        """Backtest the strategy"""
        signal = self.generate_signal()
        return self.apply_transaction_costs(returns, signal, cost)

class MeanReversion(Strategy):
    """Z-score based mean reversion strategy"""

    def __init__(self, price: pd.Series, window: int = 20,
                 entry_threshold: float = -1.0, exit_threshold: float = 0.0):
        self.price = price
        self.window = window
        self.entry_threshold = entry_threshold
        self.exit_threshold = exit_threshold

    def generate_signal(self) -> pd.Series:
        """Generate mean reversion signal"""
        zscore = compute_zscore(self.price, self.window)
        signal = pd.Series(0, index=zscore.index)

        # Entry when z-score is low (oversold)
        signal[zscore < self.entry_threshold] = 1
        # Exit when z-score returns to normal
        signal[zscore > self.exit_threshold] = 0

        # Forward fill to maintain positions
        signal = signal.replace(0, np.nan).fillna(method='ffill').fillna(0)

        return signal

    def backtest(self, returns: pd.Series, cost: float = 0.001) -> pd.Series:
        """Backtest the strategy"""
        signal = self.generate_signal()
        return self.apply_transaction_costs(returns, signal, cost)

class RSIStrategy(Strategy):
    """RSI-based mean reversion strategy"""

    def __init__(self, price: pd.Series, period: int = 14,
                 oversold: float = 30, overbought: float = 70):
        self.price = price
        self.period = period
        self.oversold = oversold
        self.overbought = overbought

    def generate_signal(self) -> pd.Series:
        """Generate RSI signal"""
        rsi = compute_rsi(self.price, self.period)
        signal = pd.Series(0, index=rsi.index)

        # Entry when RSI is oversold
        signal[rsi < self.oversold] = 1
        # Exit when RSI reaches overbought
        signal[rsi > self.overbought] = 0

        # Forward fill to maintain positions
        signal = signal.replace(0, np.nan).fillna(method='ffill').fillna(0)

        return signal

    def backtest(self, returns: pd.Series, cost: float = 0.001) -> pd.Series:
        """Backtest the strategy"""
        signal = self.generate_signal()
        return self.apply_transaction_costs(returns, signal, cost)

class BollingerBandsStrategy(Strategy):
    """Bollinger Bands mean reversion strategy"""

    def __init__(self, price: pd.Series, period: int = 20, num_std: float = 2.0):
        self.price = price
        self.period = period
        self.num_std = num_std

    def generate_signal(self) -> pd.Series:
        """Generate Bollinger Bands signal"""
        upper, middle, lower = compute_bollinger_bands(self.price, self.period, self.num_std)
        signal = pd.Series(0, index=self.price.index)

        # Entry when price touches lower band
        signal[self.price < lower] = 1
        # Exit when price returns to middle band
        signal[self.price > middle] = 0

        # Forward fill to maintain positions
        signal = signal.replace(0, np.nan).fillna(method='ffill').fillna(0)

        return signal

    def backtest(self, returns: pd.Series, cost: float = 0.001) -> pd.Series:
        """Backtest the strategy"""
        signal = self.generate_signal()
        return self.apply_transaction_costs(returns, signal, cost)

class MomentumPortfolio(Strategy):
    """Cross-sectional momentum strategy"""

    def __init__(self, prices: pd.DataFrame, lookback: int = 126,
                 top_n: int = 2, rebalance_freq: str = "ME"):
        self.prices = prices
        self.lookback = lookback
        self.top_n = top_n
        self.rebalance_freq = rebalance_freq

    def rank_assets(self) -> pd.DataFrame:
        """Rank assets by past returns"""
        past_returns = self.prices.pct_change(self.lookback, fill_method=None)
        return past_returns.rank(axis=1, ascending=False)

    def generate_weights(self) -> pd.DataFrame:
        """Generate equal-weight portfolio of top N assets"""
        ranks = self.rank_assets()
        signals = (ranks <= self.top_n).astype(int)
        weights = signals.div(signals.sum(axis=1), axis=0).fillna(0)

        # Rebalance at specified frequency
        weights = (
            weights.resample(self.rebalance_freq).last()
            .reindex(weights.index, method='ffill')
        )

        return weights

    def backtest(self, returns: pd.DataFrame, target_vol: float = 0.10) -> pd.Series:
        """Backtest momentum portfolio with volatility targeting"""
        weights = self.generate_weights()
        portfolio_returns = (weights.shift(1) * returns).sum(axis=1)

        # Apply volatility targeting
        realized_vol = portfolio_returns.rolling(20).std() * np.sqrt(252)
        scaler = safe_divide(
            pd.Series(target_vol, index=realized_vol.index),
            realized_vol
        ).clip(0, 1.5)

        return portfolio_returns * scaler.shift(1)

