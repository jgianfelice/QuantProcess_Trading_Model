    @staticmethod
    def plot_monte_carlo(mc_simulator: MonteCarloSimulator):
        """Plot Monte Carlo simulation results"""
        sims = mc_simulator.run()
        equity_curves = (1 + sims).cumprod()

        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(16, 6))

        # Equity curves
        for col in equity_curves.columns[:100]:  # Plot first 100
            ax1.plot(equity_curves.index, equity_curves[col],
                    color='blue', alpha=0.05, linewidth=0.5)

        median_curve = equity_curves.median(axis=1)
        ax1.plot(equity_curves.index, median_curve,
                color='red', linewidth=2, label='Median')
        ax1.set_ylabel('Equity', fontsize=11)
        ax1.set_xlabel('Days', fontsize=11)
        ax1.set_title('Monte Carlo Simulation Paths', fontsize=12, fontweight='bold')
        ax1.legend()
        ax1.grid(True, alpha=0.3)

        # Distribution of final returns
        final_returns = (equity_curves.iloc[-1] - 1) * 100
        ax2.hist(final_returns, bins=50, alpha=0.7, edgecolor='black')
        ax2.axvline(final_returns.median(), color='red', linestyle='--',
                   linewidth=2, label=f'Median: {final_returns.median():.1f}%')
        ax2.set_xlabel('Return (%)', fontsize=11)
        ax2.set_ylabel('Frequency', fontsize=11)
        ax2.set_title('Distribution of Final Returns', fontsize=12, fontweight='bold')
        ax2.legend()
        ax2.grid(True, alpha=0.3)

        plt.tight_layout()
        plt.show()

    @staticmethod
    def plot_strategy_allocation(regime: pd.Series):
        """Plot regime allocation over time"""
        regime_counts = regime.value_counts()

        fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 5))

        # Pie chart
        colors = {'Trend': 'green', 'Choppy': 'orange', 'Risk-Off': 'red'}
        ax1.pie(regime_counts, labels=regime_counts.index, autopct='%1.1f%%',
               colors=[colors.get(r, 'gray') for r in regime_counts.index],
               startangle=90)
        ax1.set_title('Regime Distribution', fontsize=12, fontweight='bold')

        # Time series
        regime_numeric = regime.map({'Trend': 2, 'Choppy': 1, 'Risk-Off': 0})
        ax2.plot(regime_numeric.index, regime_numeric, linewidth=0.5, alpha=0.5)
        ax2.fill_between(regime_numeric.index, 0, regime_numeric, alpha=0.3)
        ax2.set_yticks([0, 1, 2])
        ax2.set_yticklabels(['Risk-Off', 'Choppy', 'Trend'])
        ax2.set_xlabel('Date', fontsize=11)
        ax2.set_title('Regime Over Time', fontsize=12, fontweight='bold')
