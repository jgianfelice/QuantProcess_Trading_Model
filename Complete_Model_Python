def run_enhanced_backtest(ticker: str, start_date: str, end_date: Optional[str] = None,
                         initial_capital: float = 100000) -> Dict:
    """
    Run backtest using the comprehensive BacktestEngine

    Returns detailed results including:
    - Portfolio performance
    - Transaction costs breakdown
    - Risk metrics
    - Trade-by-trade analysis
    """
    print("\n" + "="*80)
    print(f"ENHANCED BACKTEST - {ticker}")
    print("="*80)

    # Fetch data
    prices, returns = DataManager.fetch_data([ticker], start_date, end_date)
    price_series = prices[ticker] if isinstance(prices, pd.DataFrame) else prices
    return_series = returns[ticker] if isinstance(returns, pd.DataFrame) else returns

    # Detect regime
    detector = RegimeDetector(price_series, return_series)
    regime = detector.detect_regime()

    # Generate signals using MA strategy
    ma_strategy = MovingAverageTrend(price_series, Config.MA_FAST, Config.MA_SLOW)
    ma_signal = ma_strategy.generate_signal()

    # Convert to DataFrame format for backtester
    prices_df = pd.DataFrame({ticker: price_series})
    signals_df = pd.DataFrame({ticker: ma_signal})

    # Create risk manager with custom parameters
    risk_mgr = RiskManager(
        max_position_size=0.25,
        max_portfolio_leverage=1.0,
        max_drawdown_limit=0.20,
        stop_loss_pct=0.05
    )

    # Create cost model
    cost_model = TransactionCostModel(
        commission=0.001,  # 10 bps
        spread_pct=0.0005,  # 5 bps
        market_impact_coef=0.1
    )

    # Run backtest
    print("\nRunning enhanced backtest with:")
    print(f"  Initial Capital: ${initial_capital:,.0f}")
    print(f"  Max Position Size: {risk_mgr.max_position_size:.1%}")
    print(f"  Stop Loss: {risk_mgr.stop_loss_pct:.1%}")
    print(f"  Transaction Costs: Commission={cost_model.commission:.2%}, Spread={cost_model.spread_pct:.2%}")

    engine = BacktestEngine(initial_capital, risk_mgr, cost_model)
    portfolio = engine.run_backtest(prices_df, signals_df)

    # Get performance summary
    performance = portfolio.get_performance_summary()

    # Print results
    print("\n" + "="*80)
    print("ENHANCED BACKTEST RESULTS")
    print("="*80)
    print(f"Initial Capital:     ${performance.get('initial_capital', 0):>12,.0f}")
    print(f"Final Value:         ${performance.get('final_value', 0):>12,.0f}")
    print(f"Total Return:        {performance.get('total_return', 0):>12.2%}")
    print(f"CAGR:                {performance.get('cagr', 0):>12.2%}")
    print(f"\nTotal Trades:        {performance.get('total_trades', 0):>12.0f}")
    print(f"Winning Trades:      {performance.get('winning_trades', 0):>12.0f}")
    print(f"Losing Trades:       {performance.get('losing_trades', 0):>12.0f}")
    print(f"Win Rate:            {performance.get('win_rate', 0):>12.2%}")
    print(f"\nGross P&L:           ${performance.get('total_pnl', 0):>12,.0f}")
    print(f"Transaction Costs:   ${performance.get('total_costs', 0):>12,.0f}")
    print(f"Net P&L:             ${performance.get('net_pnl', 0):>12,.0f}")
    print(f"\nSharpe Ratio:        {performance.get('sharpe', 0):>12.2f}")
    print(f"Sortino Ratio:       {performance.get('sortino', 0):>12.2f}")
    print(f"Max Drawdown:        {performance.get('max_drawdown', 0):>12.2%}")
    print(f"Calmar Ratio:        {performance.get('calmar', 0):>12.2f}")
    print("="*80)

    # Plot equity curve
    if portfolio.equity_curve:
        equity_df = pd.DataFrame(portfolio.equity_curve)
        equity_df.set_index('date', inplace=True)

        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(14, 8), sharex=True)

        # Equity curve
        ax1.plot(equity_df.index, equity_df['value'], label='Portfolio Value', linewidth=2)
        ax1.axhline(y=initial_capital, color='gray', linestyle='--', alpha=0.5, label='Initial Capital')
        ax1.set_ylabel('Portfolio Value ($)', fontsize=11)
        ax1.set_title(f'{ticker} - Enhanced Backtest Results', fontsize=13, fontweight='bold')
        ax1.legend(loc='upper left')
        ax1.grid(True, alpha=0.3)

        # Drawdown
        equity_peak = equity_df['value'].cummax()
        drawdown = (equity_df['value'] - equity_peak) / equity_peak
        ax2.fill_between(equity_df.index, 0, drawdown * 100, alpha=0.3, color='red')
        ax2.plot(equity_df.index, drawdown * 100, color='red', linewidth=1)
        ax2.set_ylabel('Drawdown (%)', fontsize=11)
        ax2.set_xlabel('Date', fontsize=11)
        ax2.grid(True, alpha=0.3)

        plt.tight_layout()
        plt.show()

    return {
        'portfolio': portfolio,
        'performance': performance,
        'engine': engine
    }

