class Position:
    """Represents a trading position with trailing stop support"""

    def __init__(self, ticker: str, quantity: float, entry_price: float,
                 entry_date: datetime, position_type: str = 'LONG'):
        self.ticker = ticker
        self.quantity = quantity
        self.entry_price = entry_price
        self.entry_date = entry_date
        self.position_type = position_type
        self.exit_price = None
        self.exit_date = None
        self.realized_pnl = 0.0

        # Trailing stop tracking
        self.highest_price = entry_price if position_type == 'LONG' else entry_price
        self.lowest_price = entry_price if position_type == 'SHORT' else entry_price
        self.trailing_stop_pct = None  # Set by risk manager if enabled

    def update_trailing_stop(self, current_price: float):
        """Update trailing stop levels"""
        if self.position_type == 'LONG':
            if current_price > self.highest_price:
                self.highest_price = current_price
        else:  # SHORT
            if current_price < self.lowest_price:
                self.lowest_price = current_price

    def check_trailing_stop(self, current_price: float) -> bool:
        """Check if trailing stop is hit"""
        if self.trailing_stop_pct is None:
            return False

        if self.position_type == 'LONG':
            # Long position: check if price dropped from highest
            drop_from_high = (self.highest_price - current_price) / self.highest_price
            return drop_from_high >= self.trailing_stop_pct
        else:  # SHORT
            # Short position: check if price rose from lowest
            rise_from_low = (current_price - self.lowest_price) / self.lowest_price
            return rise_from_low >= self.trailing_stop_pct

    def close_position(self, exit_price: float, exit_date: datetime) -> float:
        """Close the position and calculate P&L"""
        self.exit_price = exit_price
        self.exit_date = exit_date

        if self.position_type == 'LONG':
            self.realized_pnl = (exit_price - self.entry_price) * self.quantity
        else:  # SHORT
            self.realized_pnl = (self.entry_price - exit_price) * self.quantity

        return self.realized_pnl

    def unrealized_pnl(self, current_price: float) -> float:
        """Calculate unrealized P&L"""
        if self.position_type == 'LONG':
            return (current_price - self.entry_price) * self.quantity
        else:
            return (self.entry_price - current_price) * self.quantity

    def market_value(self, current_price: float) -> float:
        """Calculate current market value"""
        return current_price * abs(self.quantity)

class RiskManager:
    """Comprehensive risk management module"""

    def __init__(self, max_position_size: float = 0.25, max_portfolio_leverage: float = 1.0,
                 max_drawdown_limit: float = 0.20, stop_loss_pct: float = 0.05,
                 enable_trailing_stop: bool = True, trailing_stop_pct: float = 0.10):
        self.max_position_size = max_position_size
        self.max_portfolio_leverage = max_portfolio_leverage
        self.max_drawdown_limit = max_drawdown_limit
        self.stop_loss_pct = stop_loss_pct
        self.enable_trailing_stop = enable_trailing_stop
        self.trailing_stop_pct = trailing_stop_pct

        # Drawdown tracking
        self.drawdown_actions_taken = []

    def calculate_position_size(self, portfolio_value: float, volatility: float,
                               risk_per_trade: float = 0.02, method: str = 'volatility_target',
                               num_positions: int = 1) -> float:
        """
        Calculate position size using various methods

        Args:
            portfolio_value: Current portfolio value
            volatility: Asset volatility (annualized)
            risk_per_trade: Risk as fraction of portfolio (e.g., 0.02 = 2%)
            method: 'fixed_risk', 'volatility_target', 'kelly', 'equal_weight', or 'vol_scaled'
            num_positions: Number of positions in portfolio (for equal_weight)

        Returns:
            Position size as fraction of portfolio
        """
        if method == 'fixed_risk':
            # Risk fixed percentage of portfolio
            if volatility > 0:
                position_size = risk_per_trade / volatility
            else:
                position_size = risk_per_trade

        elif method == 'volatility_target' or method == 'vol_target':
            # Target specific volatility
            target_vol = 0.10  # 10% target
            if volatility > 0:
                position_size = target_vol / volatility
            else:
                position_size = 0.1

        elif method == 'vol_scaled' or method == 'volatility_scaled':
            # Inverse volatility weighting for multi-asset
            # Higher allocation to lower volatility assets
            if volatility > 0:
                base_allocation = 1.0 / num_positions
                vol_scalar = 0.15 / volatility  # 15% reference volatility
                position_size = base_allocation * vol_scalar
            else:
                position_size = 1.0 / num_positions

        elif method == 'kelly':
            # Simplified Kelly Criterion
            # Assumes 55% win rate and 1.5 win/loss ratio
            win_rate = 0.55
            win_loss_ratio = 1.5
            kelly = (win_rate * win_loss_ratio - (1 - win_rate)) / win_loss_ratio
            position_size = kelly * 0.5  # Use half-Kelly for safety

        elif method == 'equal_weight':
            # Equal weight across N positions
            position_size = 1.0 / max(num_positions, 1)

        else:
            position_size = 0.1  # Default 10%

        # Apply maximum position size constraint
        position_size = min(position_size, self.max_position_size)

        # Apply minimum
        return max(position_size, 0.01)  # Minimum 1%

    def check_stop_loss(self, position: Position, current_price: float) -> bool:
        """Check if position hits stop loss"""
        if position.position_type == 'LONG':
            loss_pct = (current_price - position.entry_price) / position.entry_price
            return loss_pct <= -self.stop_loss_pct
        else:  # SHORT
            loss_pct = (position.entry_price - current_price) / position.entry_price
            return loss_pct <= -self.stop_loss_pct

    def check_trailing_stop(self, position: Position, current_price: float) -> bool:
        """Check if trailing stop is hit"""
        if not self.enable_trailing_stop:
            return False

        # Update position's highest/lowest price
        position.update_trailing_stop(current_price)

        # Set trailing stop percentage if not set
        if position.trailing_stop_pct is None:
            position.trailing_stop_pct = self.trailing_stop_pct

        # Check if trailing stop triggered
        return position.check_trailing_stop(current_price)

    def check_portfolio_risk(self, portfolio_value: float, equity_peak: float) -> bool:
        """Check if portfolio exceeds maximum drawdown"""
        if equity_peak > 0:
            current_dd = (portfolio_value - equity_peak) / equity_peak
            return current_dd <= -self.max_drawdown_limit
        return False

    def get_drawdown_action(self, current_dd: float) -> str:
        """
        Determine action based on drawdown severity

        Returns:
            Action: 'NORMAL', 'REDUCE', 'HALT', or 'LIQUIDATE'
        """
        abs_dd = abs(current_dd)

        if abs_dd < 0.05:  # Less than 5%
            return 'NORMAL'
        elif abs_dd < 0.10:  # 5-10%
            return 'REDUCE'  # Reduce position sizes by 50%
        elif abs_dd < self.max_drawdown_limit:  # 10-20%
            return 'HALT'  # Stop opening new positions
        else:  # Over 20%
            return 'LIQUIDATE'  # Close all positions

    def calculate_var(self, returns: pd.Series, confidence: float = 0.95) -> float:
        """Calculate Value at Risk"""
        if len(returns) == 0:
            return 0.0
        return returns.quantile(1 - confidence)

    def calculate_cvar(self, returns: pd.Series, confidence: float = 0.95) -> float:
        """Calculate Conditional Value at Risk (Expected Shortfall)"""
        if len(returns) == 0:
            return 0.0
        var = self.calculate_var(returns, confidence)
        return returns[returns <= var].mean() if (returns <= var).any() else var

class TransactionCostModel:
    """Model transaction costs and market impact"""

    def __init__(self, commission: float = 0.001, spread_pct: float = 0.0005,
                 market_impact_coef: float = 0.1):
        self.commission = commission  # 10 bps
        self.spread_pct = spread_pct  # 5 bps
        self.market_impact_coef = market_impact_coef

    def calculate_total_cost(self, trade_value: float, volatility: float,
                            avg_volume: float = 1000000, is_buy: bool = True) -> float:
        """
        Calculate total transaction cost

        Components:
        1. Commission (fixed)
        2. Bid-ask spread
        3. Market impact (depends on trade size)
        4. Slippage (volatility-dependent)
        """
        # 1. Commission
        commission_cost = trade_value * self.commission

        # 2. Spread cost
        spread_cost = trade_value * self.spread_pct

        # 3. Market impact (square-root model)
        if avg_volume > 0:
            participation_rate = trade_value / avg_volume
            market_impact = trade_value * self.market_impact_coef * np.sqrt(participation_rate)
        else:
            market_impact = 0

        # 4. Slippage (increases with volatility)
        base_slippage = 0.0005  # 5 bps base
        vol_multiplier = 1 + (volatility / 0.20)  # Scale with volatility
        slippage_cost = trade_value * base_slippage * vol_multiplier

        total_cost = commission_cost + spread_cost + market_impact + slippage_cost

        return total_cost

    def get_execution_price(self, market_price: float, trade_value: float,
                           volatility: float, is_buy: bool = True) -> float:
        """Get realistic execution price accounting for slippage"""
        cost_pct = self.calculate_total_cost(trade_value, volatility) / trade_value

        if is_buy:
            execution_price = market_price * (1 + cost_pct)
        else:
            execution_price = market_price * (1 - cost_pct)

        return execution_price

class Portfolio:
    """Portfolio management class for backtesting"""

    def __init__(self, initial_capital: float = 100000,
                 risk_manager: Optional[RiskManager] = None,
                 cost_model: Optional[TransactionCostModel] = None):
        self.initial_capital = initial_capital
        self.cash = initial_capital
        self.positions = {}  # ticker -> Position
        self.closed_positions = []
        self.equity_curve = []
        self.equity_peak = initial_capital

        self.risk_manager = risk_manager or RiskManager()
        self.cost_model = cost_model or TransactionCostModel()

        # Performance tracking
        self.total_trades = 0
        self.winning_trades = 0
        self.losing_trades = 0
        self.total_pnl = 0.0
        self.total_costs = 0.0

    def update(self, date: datetime, prices: Dict[str, float],
               volatilities: Dict[str, float] = None):
        """Update portfolio value and check stops"""
        if volatilities is None:
            volatilities = {ticker: 0.20 for ticker in prices.keys()}

        # Check stop losses and trailing stops
        positions_to_close = []
        for ticker, position in self.positions.items():
            if ticker in prices:
                current_price = prices[ticker]

                # Check fixed stop loss
                if self.risk_manager.check_stop_loss(position, current_price):
                    positions_to_close.append((ticker, current_price, date, 'STOP_LOSS'))
                # Check trailing stop
                elif self.risk_manager.check_trailing_stop(position, current_price):
                    positions_to_close.append((ticker, current_price, date, 'TRAILING_STOP'))

        # Close positions that hit stops
        for ticker, price, close_date, reason in positions_to_close:
            self.close_position(ticker, price, close_date, reason=reason)

        # Update equity curve
        portfolio_value = self.get_portfolio_value(prices)
        self.equity_curve.append({
            'date': date,
            'value': portfolio_value,
            'cash': self.cash,
            'positions_value': portfolio_value - self.cash
        })

        # Update equity peak
        if portfolio_value > self.equity_peak:
            self.equity_peak = portfolio_value

        # Check maximum drawdown and take action
        current_dd = (portfolio_value - self.equity_peak) / self.equity_peak if self.equity_peak > 0 else 0
        action = self.risk_manager.get_drawdown_action(current_dd)

        if action == 'LIQUIDATE':
            print(f"WARNING: Maximum drawdown {current_dd:.2%} exceeded on {date}")
            print("LIQUIDATING ALL POSITIONS")
            # Close all positions
            for ticker in list(self.positions.keys()):
                if ticker in prices:
                    self.close_position(ticker, prices[ticker], date, reason='MAX_DRAWDOWN')
        elif action == 'HALT':
            print(f"WARNING: Drawdown {current_dd:.2%} - HALTING new positions on {date}")
        elif action == 'REDUCE':
            print(f"WARNING: Drawdown {current_dd:.2%} - REDUCING position sizes on {date}")

    def open_position(self, ticker: str, signal: float, price: float,
                     date: datetime, volatility: float = 0.20,
                     position_sizing_method: str = 'volatility_target'):
        """Open a new position"""
        portfolio_value = self.get_portfolio_value({ticker: price})

        # Calculate position size
        position_size_pct = self.risk_manager.calculate_position_size(
            portfolio_value, volatility, method=position_sizing_method
        )

        # Calculate dollar amount
        position_value = portfolio_value * position_size_pct

        # Don't exceed available cash
        position_value = min(position_value, self.cash * 0.95)  # Keep 5% cash buffer

        if position_value < 100:  # Minimum position size
            return

        # Calculate execution price with costs
        execution_price = self.cost_model.get_execution_price(
            price, position_value, volatility, is_buy=(signal > 0)
        )

        # Calculate transaction costs
        costs = self.cost_model.calculate_total_cost(position_value, volatility)
        self.total_costs += costs

        # Calculate quantity
        quantity = position_value / execution_price

        # Determine position type
        position_type = 'LONG' if signal > 0 else 'SHORT'

        # Create position
        position = Position(ticker, quantity, execution_price, date, position_type)

        # Update cash
        self.cash -= (position_value + costs)

        # Store position
        self.positions[ticker] = position
        self.total_trades += 1

    def close_position(self, ticker: str, price: float, date: datetime,
                      reason: str = 'SIGNAL'):
        """Close an existing position"""
        if ticker not in self.positions:
            return

        position = self.positions[ticker]

        # Calculate position value
        position_value = position.market_value(price)

        # Calculate volatility (simplified)
        volatility = 0.20

        # Get execution price
        execution_price = self.cost_model.get_execution_price(
            price, position_value, volatility, is_buy=False
        )

        # Calculate costs
        costs = self.cost_model.calculate_total_cost(position_value, volatility)
        self.total_costs += costs

        # Close position
        pnl = position.close_position(execution_price, date)

        # Update cash
        proceeds = position_value - costs
        self.cash += proceeds

        # Track performance
        self.total_pnl += pnl
        if pnl > 0:
            self.winning_trades += 1
        else:
            self.losing_trades += 1

        # Move to closed positions
        self.closed_positions.append(position)
        del self.positions[ticker]

    def get_portfolio_value(self, prices: Dict[str, float]) -> float:
        """Calculate total portfolio value"""
        positions_value = sum(
            pos.market_value(prices.get(ticker, pos.entry_price))
            for ticker, pos in self.positions.items()
        )
        return self.cash + positions_value

    def get_returns(self) -> pd.Series:
        """Get portfolio returns series"""
        if not self.equity_curve:
            return pd.Series()

        df = pd.DataFrame(self.equity_curve)
        df.set_index('date', inplace=True)
        returns = df['value'].pct_change().dropna()
        return returns

    def get_performance_summary(self) -> Dict:
        """Get comprehensive performance summary"""
        returns = self.get_returns()

        if len(returns) == 0:
            return {}

        final_value = self.equity_curve[-1]['value']
        total_return = (final_value - self.initial_capital) / self.initial_capital

        # Calculate metrics using PerformanceAnalytics
        analytics = PerformanceAnalytics()
        metrics = analytics.calculate_metrics(returns)

        # Add portfolio-specific metrics
        metrics['initial_capital'] = self.initial_capital
        metrics['final_value'] = final_value
        metrics['total_pnl'] = self.total_pnl
        metrics['total_costs'] = self.total_costs
        metrics['net_pnl'] = self.total_pnl - self.total_costs
        metrics['total_trades'] = self.total_trades
        metrics['winning_trades'] = self.winning_trades
        metrics['losing_trades'] = self.losing_trades
        metrics['win_rate'] = self.winning_trades / self.total_trades if self.total_trades > 0 else 0

        return metrics

