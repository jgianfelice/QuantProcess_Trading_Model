class Factor:
    """Base class for factor calculation"""

    def __init__(self, name: str):
        self.name = name

    def calculate(self, prices: pd.DataFrame, returns: pd.DataFrame,
                 fundamentals: Optional[Dict] = None) -> pd.Series:
        """Calculate factor values for each asset"""
        raise NotImplementedError

    def get_signal(self, factor_values: pd.Series,
                   method: str = 'zscore') -> pd.Series:
        """
        Convert factor values to signals

        Args:
            factor_values: Raw factor values
            method: 'zscore', 'rank', or 'quintile'

        Returns:
            Normalized signals
        """
        if method == 'zscore':
            # Z-score normalization
            mean = factor_values.mean()
            std = factor_values.std()
            if std > 0:
                return (factor_values - mean) / std
            return pd.Series(0, index=factor_values.index)

        elif method == 'rank':
            # Rank from 0 to 1
            return factor_values.rank(pct=True)

        elif method == 'quintile':
            # Quintile ranking (-2 to +2)
            quintiles = pd.qcut(factor_values, q=5, labels=False, duplicates='drop')
            return quintiles - 2

        return factor_values

class MomentumFactor(Factor):
    """
    Momentum Factor - Past returns predict future returns

    Measures: Recent price performance
    Theory: Winners continue winning, losers continue losing
    """

    def __init__(self, lookback_periods: List[int] = [21, 63, 126, 252]):
        """
        Args:
            lookback_periods: List of lookback periods in days
                             Default: 1m, 3m, 6m, 12m
        """
        super().__init__("Momentum")
        self.lookback_periods = lookback_periods

    def calculate(self, prices: pd.DataFrame, returns: pd.DataFrame,
                 fundamentals: Optional[Dict] = None) -> pd.DataFrame:
        """
        Calculate momentum for multiple lookback periods

        Returns:
            DataFrame with momentum values for each period
        """
        momentum_factors = {}

        for period in self.lookback_periods:
            period_name = f"mom_{period}d"

            # Calculate cumulative returns over period
            if len(prices) >= period:
                period_returns = prices.pct_change(period, fill_method=None)
                momentum_factors[period_name] = period_returns.iloc[-1]
            else:
                # Not enough data
                momentum_factors[period_name] = pd.Series(0, index=prices.columns)

        momentum_df = pd.DataFrame(momentum_factors)

        # Composite momentum (average across periods)
        momentum_df['composite'] = momentum_df.mean(axis=1)

        return momentum_df

    def calculate_residual_momentum(self, returns: pd.DataFrame,
                                    market_returns: pd.Series) -> pd.Series:
        """
        Calculate residual momentum (alpha momentum)

        Returns momentum after removing market beta
        """
        residual_mom = {}

        for ticker in returns.columns:
            asset_returns = returns[ticker].dropna()
            aligned_market = market_returns.reindex(asset_returns.index).dropna()

            if len(asset_returns) > 30:
                # Simple beta calculation
                covariance = asset_returns.cov(aligned_market)
                market_variance = aligned_market.var()

                if market_variance > 0:
                    beta = covariance / market_variance
                    residual = asset_returns - beta * aligned_market
                    residual_mom[ticker] = residual.mean()
                else:
                    residual_mom[ticker] = asset_returns.mean()
            else:
                residual_mom[ticker] = 0

        return pd.Series(residual_mom)

class VolatilityFactor(Factor):
    """
    Volatility Factor - Low volatility anomaly

    Measures: Price volatility
    Theory: Low volatility stocks outperform high volatility stocks
           (contradicts CAPM)
    """

    def __init__(self, lookback_periods: List[int] = [21, 63, 252]):
        """
        Args:
            lookback_periods: Volatility measurement periods
                             Default: 1m, 3m, 12m
        """
        super().__init__("Volatility")
        self.lookback_periods = lookback_periods

    def calculate(self, prices: pd.DataFrame, returns: pd.DataFrame,
                 fundamentals: Optional[Dict] = None) -> pd.DataFrame:
        """
        Calculate volatility measures

        Returns:
            DataFrame with volatility for each period (annualized)
        """
        volatility_factors = {}

        for period in self.lookback_periods:
            period_name = f"vol_{period}d"

            if len(returns) >= period:
                # Rolling volatility (annualized)
                rolling_vol = returns.rolling(period).std() * np.sqrt(252)
                volatility_factors[period_name] = rolling_vol.iloc[-1]
            else:
                volatility_factors[period_name] = pd.Series(np.nan, index=returns.columns)

        vol_df = pd.DataFrame(volatility_factors)

        # Composite volatility (average)
        vol_df['composite'] = vol_df.mean(axis=1)

        # Invert for low-vol strategy (negative sign = prefer low vol)
        vol_df['low_vol_signal'] = -vol_df['composite']

        return vol_df

    def calculate_downside_volatility(self, returns: pd.DataFrame,
                                     threshold: float = 0) -> pd.Series:
        """Calculate downside volatility (semi-deviation)"""
        downside_vol = {}

        for ticker in returns.columns:
            asset_returns = returns[ticker].dropna()
            downside_returns = asset_returns[asset_returns < threshold]

            if len(downside_returns) > 0:
                downside_vol[ticker] = downside_returns.std() * np.sqrt(252)
            else:
                downside_vol[ticker] = 0

        return pd.Series(downside_vol)

class ValueFactor(Factor):
    """
    Value Factor - Cheap stocks outperform expensive stocks

    Measures: P/E, P/B, P/S, Dividend Yield, EV/EBITDA
    Theory: Value stocks are underpriced and provide better returns

    Note: Requires fundamental data (yfinance provides some)
    """

    def __init__(self):
        super().__init__("Value")

    def calculate(self, prices: pd.DataFrame, returns: pd.DataFrame,
                 fundamentals: Optional[Dict] = None) -> pd.DataFrame:
        """
        Calculate value metrics

        Args:
            fundamentals: Dict of {ticker: {metric: value}}

        Returns:
            DataFrame with value scores
        """
        value_factors = {}

        for ticker in prices.columns:
            if fundamentals and ticker in fundamentals:
                fund = fundamentals[ticker]

                value_factors[ticker] = {
                    'pe_ratio': fund.get('trailingPE', np.nan),
                    'pb_ratio': fund.get('priceToBook', np.nan),
                    'ps_ratio': fund.get('priceToSalesTrailing12Months', np.nan),
                    'div_yield': fund.get('dividendYield', 0) * 100 if fund.get('dividendYield') else 0,
                    'ev_ebitda': fund.get('enterpriseToEbitda', np.nan)
                }
            else:
                # No fundamental data available
                value_factors[ticker] = {
                    'pe_ratio': np.nan,
                    'pb_ratio': np.nan,
                    'ps_ratio': np.nan,
                    'div_yield': np.nan,
                    'ev_ebitda': np.nan
                }

        value_df = pd.DataFrame(value_factors).T

        # Calculate composite value score
        # Lower P/E, P/B, P/S is better (inverted)
        # Higher dividend yield is better

        value_scores = pd.Series(0.0, index=value_df.index)

        if not value_df['pe_ratio'].isna().all():
            # Invert P/E (lower is better)
            pe_score = -value_df['pe_ratio'].rank(pct=True)
            value_scores += pe_score.fillna(0)

        if not value_df['pb_ratio'].isna().all():
            pb_score = -value_df['pb_ratio'].rank(pct=True)
            value_scores += pb_score.fillna(0)

        if not value_df['div_yield'].isna().all():
            # Higher dividend yield is better
            div_score = value_df['div_yield'].rank(pct=True)
            value_scores += div_score.fillna(0)

        value_df['composite'] = value_scores

        return value_df

    def fetch_fundamentals(self, tickers: List[str]) -> Dict:
        """Fetch fundamental data from yfinance"""
        fundamentals = {}

        print("Fetching fundamental data...")
        for ticker in tickers:
            try:
                stock = yf.Ticker(ticker)
                info = stock.info

                fundamentals[ticker] = {
                    'trailingPE': info.get('trailingPE'),
                    'priceToBook': info.get('priceToBook'),
                    'priceToSalesTrailing12Months': info.get('priceToSalesTrailing12Months'),
                    'dividendYield': info.get('dividendYield'),
                    'enterpriseToEbitda': info.get('enterpriseToEbitda'),
                    'marketCap': info.get('marketCap'),
                    'sector': info.get('sector')
                }
                print(f"  {ticker}: ✓")
            except:
                print(f"  {ticker}: ✗ (no data)")
                fundamentals[ticker] = {}

        return fundamentals

class MultiFactorModel:
    """
    Multi-Factor Model combining multiple factors

    Combines momentum, volatility, and value factors to generate
    portfolio weights and trading signals
    """

    def __init__(self, factors: Optional[List[Factor]] = None,
                 factor_weights: Optional[Dict[str, float]] = None):
        """
        Args:
            factors: List of Factor objects to use
            factor_weights: Dict of {factor_name: weight}
                          If None, equal weight
        """
        if factors is None:
            # Default: momentum and volatility (value needs fundamentals)
            self.factors = [
                MomentumFactor(),
                VolatilityFactor()
            ]
        else:
            self.factors = factors

        self.factor_weights = factor_weights or {}
        self.factor_scores = {}
        self.combined_scores = None
        self.decile_ranks = None  # For decile-based portfolio construction

    def calculate_factor_scores(self, prices: pd.DataFrame,
                                returns: pd.DataFrame,
                                fundamentals: Optional[Dict] = None) -> Dict[str, pd.Series]:
        """
        Calculate scores for all factors

        Returns:
            Dict of {factor_name: scores}
        """
        scores = {}

        for factor in self.factors:
            print(f"Calculating {factor.name} factor...")

            factor_values = factor.calculate(prices, returns, fundamentals)

            # Get composite score
            if 'composite' in factor_values.columns:
                composite = factor_values['composite']
            elif 'low_vol_signal' in factor_values.columns:
                composite = factor_values['low_vol_signal']
            else:
                composite = factor_values.iloc[:, 0]

            # Normalize to z-scores
            normalized = factor.get_signal(composite, method='zscore')
            scores[factor.name] = normalized

        self.factor_scores = scores
        return scores

    def combine_factors(self, factor_scores: Optional[Dict[str, pd.Series]] = None,
                       method: str = 'equal_weight') -> pd.Series:
        """
        Combine multiple factors into single score

        Args:
            factor_scores: Dict of factor scores (uses self.factor_scores if None)
            method: 'equal_weight', 'custom', or 'ic_weighted'

        Returns:
            Combined factor scores
        """
        if factor_scores is None:
            factor_scores = self.factor_scores

        if not factor_scores:
            raise ValueError("No factor scores available")

        # Convert to DataFrame
        scores_df = pd.DataFrame(factor_scores)

        if method == 'equal_weight':
            # Simple average
            combined = scores_df.mean(axis=1)

        elif method == 'custom':
            # Use provided weights
            if not self.factor_weights:
                raise ValueError("Must provide factor_weights for custom weighting")

            combined = pd.Series(0.0, index=scores_df.index)
            for factor_name, weight in self.factor_weights.items():
                if factor_name in scores_df.columns:
                    combined += scores_df[factor_name] * weight

        else:
            combined = scores_df.mean(axis=1)

        self.combined_scores = combined
        return combined

    def rank_assets_by_decile(self, combined_scores: Optional[pd.Series] = None) -> pd.Series:
        """
        Rank assets into deciles (1-10)

        Decile 1 = Bottom 10% (worst performers)
        Decile 10 = Top 10% (best performers)

        Args:
            combined_scores: Combined factor scores

        Returns:
            Series of decile rankings (1 = bottom, 10 = top)
        """
        if combined_scores is None:
            combined_scores = self.combined_scores

        if combined_scores is None:
            raise ValueError("Must calculate combined scores first")

        # Remove NaN
        scores = combined_scores.dropna()
        n_assets = len(scores)

        if n_assets < 10:
            # Not enough assets for 10 deciles, use quintiles (5 groups)
            print(f"\nNote: Only {n_assets} assets available.")
            print(f"Using {min(n_assets, 5)} groups instead of 10 deciles.")

            n_groups = min(n_assets, 5)
            try:
                ranks = pd.qcut(scores, q=n_groups, labels=False, duplicates='drop') + 1
            except ValueError:
                # Too many duplicates even for fewer groups
                ranks = scores.rank(method='first', pct=True)
                ranks = (ranks * n_groups).astype(int) + 1
                ranks = ranks.clip(1, n_groups)

        elif n_assets < 20:
            # 10-19 assets: use 5 quintiles
            print(f"\nNote: {n_assets} assets - using 5 groups (quintiles)")
            try:
                ranks = pd.qcut(scores, q=5, labels=False, duplicates='drop') + 1
            except ValueError:
                ranks = scores.rank(method='first', pct=True)
                ranks = (ranks * 5).astype(int) + 1
                ranks = ranks.clip(1, 5)

        else:
            # 20+ assets: use full 10 deciles
            try:
                ranks = pd.qcut(scores, q=10, labels=False, duplicates='drop') + 1
            except ValueError:
                # If too many duplicates, fall back to ranking
                ranks = scores.rank(method='first', pct=True)
                ranks = (ranks * 10).astype(int) + 1
                ranks = ranks.clip(1, 10)

        self.decile_ranks = ranks
        return ranks

    def get_top_decile(self, decile_ranks: Optional[pd.Series] = None) -> List[str]:
        """
        Get assets in top decile (highest scores)

        Returns:
            List of ticker symbols in top decile
        """
        if decile_ranks is None:
            decile_ranks = self.decile_ranks

        if decile_ranks is None:
            raise ValueError("Must calculate decile ranks first")

        # Top decile has highest rank number
        top_decile = decile_ranks[decile_ranks == decile_ranks.max()]
        return top_decile.index.tolist()

    def get_bottom_decile(self, decile_ranks: Optional[pd.Series] = None) -> List[str]:
        """
        Get assets in bottom decile (lowest scores)

        Returns:
            List of ticker symbols in bottom decile
        """
        if decile_ranks is None:
            decile_ranks = self.decile_ranks

        if decile_ranks is None:
            raise ValueError("Must calculate decile ranks first")

        # Bottom decile has lowest rank number
        bottom_decile = decile_ranks[decile_ranks == decile_ranks.min()]
        return bottom_decile.index.tolist()

    def generate_long_short_decile_portfolio(self,
                                            combined_scores: Optional[pd.Series] = None,
                                            long_allocation: float = 1.0,
                                            short_allocation: float = 1.0) -> pd.Series:
        """
        Generate long-short portfolio: Long top decile, Short bottom decile

        Classic factor portfolio construction:
        - Long the top 10% of assets (best factor scores)
        - Short the bottom 10% of assets (worst factor scores)
        - Equal weight within each decile

        Args:
            combined_scores: Combined factor scores
            long_allocation: Total capital for long positions (1.0 = 100%)
            short_allocation: Total capital for short positions (1.0 = 100%)

        Returns:
            Portfolio weights (positive = long, negative = short)
        """
        if combined_scores is None:
            combined_scores = self.combined_scores

        n_assets = len(combined_scores.dropna())

        # Warn if too few assets
        if n_assets < 10:
            print(f"\n⚠ WARNING: Only {n_assets} assets provided.")
            print(f"  Recommended: 20-50 assets for proper decile analysis")
            print(f"  Minimum: 10 assets")
            print(f"  Current strategy: Long top {1}/{n_assets}, Short bottom {1}/{n_assets}")

        # Rank into deciles (or fewer groups if needed)
        decile_ranks = self.rank_assets_by_decile(combined_scores)

        # Get top and bottom groups
        top_group = self.get_top_decile(decile_ranks)
        bottom_group = self.get_bottom_decile(decile_ranks)

        print(f"\nPortfolio Construction:")
        print(f"  Total Assets: {n_assets}")
        print(f"  Top Group (LONG): {len(top_group)} assets")
        print(f"  Bottom Group (SHORT): {len(bottom_group)} assets")
        print(f"  Long Allocation: {long_allocation:.0%}")
        print(f"  Short Allocation: {short_allocation:.0%}")

        # Initialize weights
        weights = pd.Series(0.0, index=combined_scores.index)

        # Long positions (equal weight within top group)
        if len(top_group) > 0:
            long_weight_per_asset = long_allocation / len(top_group)
            for ticker in top_group:
                weights[ticker] = long_weight_per_asset

        # Short positions (equal weight within bottom group)
        if len(bottom_group) > 0:
            short_weight_per_asset = -short_allocation / len(bottom_group)
            for ticker in bottom_group:
                weights[ticker] = short_weight_per_asset

        return weights

    def print_decile_analysis(self):
        """Print detailed decile distribution"""
        if self.decile_ranks is None:
            print("No decile ranks calculated. Call rank_assets_by_decile() first.")
            return

        print("\n" + "="*80)
        print("DECILE DISTRIBUTION")
        print("="*80)

        for decile in sorted(self.decile_ranks.unique()):
            assets_in_decile = self.decile_ranks[self.decile_ranks == decile]

            if len(assets_in_decile) > 0:
                print(f"\nDecile {decile}: {len(assets_in_decile)} assets")
                for ticker in assets_in_decile.index:
                    score = self.combined_scores[ticker] if self.combined_scores is not None else 0
                    print(f"  {ticker}: score {score:.3f}")

        # Highlight top and bottom
        top_decile = self.get_top_decile()
        bottom_decile = self.get_bottom_decile()

        print(f"\n" + "="*80)
        print(f"PORTFOLIO POSITIONS:")
        print(f"  LONG (Top Decile): {', '.join(top_decile)}")
        print(f"  SHORT (Bottom Decile): {', '.join(bottom_decile)}")
        print("="*80)

    def generate_portfolio_weights(self, combined_scores: Optional[pd.Series] = None,
                                  method: str = 'long_only',
                                  top_n: Optional[int] = None,
                                  long_allocation: float = 1.0,
                                  short_allocation: float = 1.0) -> pd.Series:
        """
        Generate portfolio weights from factor scores

        Args:
            combined_scores: Combined factor scores
            method: 'long_only', 'long_short', 'long_short_decile', or 'ranked'
            top_n: Number of top assets to hold (for long_only/ranked)
            long_allocation: Long capital (for long_short_decile)
            short_allocation: Short capital (for long_short_decile)

        Returns:
            Portfolio weights
        """
        if combined_scores is None:
            combined_scores = self.combined_scores

        if combined_scores is None:
            raise ValueError("Must calculate combined scores first")

        # Remove NaN
        scores = combined_scores.dropna()

        if len(scores) == 0:
            return pd.Series()

        if method == 'long_short_decile':
            # Decile-based long-short
            return self.generate_long_short_decile_portfolio(
                scores, long_allocation, short_allocation
            )

        elif method == 'long_only':
            # Only long positive scores
            positive_scores = scores[scores > 0]

            if len(positive_scores) == 0:
                return pd.Series(0, index=scores.index)

            # Select top N if specified
            if top_n and len(positive_scores) > top_n:
                positive_scores = positive_scores.nlargest(top_n)

            # Normalize to sum to 1
            weights = positive_scores / positive_scores.sum()

            # Ensure all tickers present
            return weights.reindex(scores.index, fill_value=0)

        elif method == 'long_short':
            # Long high scores, short low scores
            # Top 30% long, bottom 30% short
            n_long = max(1, int(len(scores) * 0.3))
            n_short = max(1, int(len(scores) * 0.3))

            long_assets = scores.nlargest(n_long)
            short_assets = scores.nsmallest(n_short)

            weights = pd.Series(0.0, index=scores.index)

            # Long positions (50% of capital)
            if len(long_assets) > 0:
                weights[long_assets.index] = 0.5 / len(long_assets)

            # Short positions (50% of capital)
            if len(short_assets) > 0:
                weights[short_assets.index] = -0.5 / len(short_assets)

            return weights

        elif method == 'ranked':
            # Weight proportional to rank
            ranks = scores.rank(pct=True)

            if top_n:
                top_assets = scores.nlargest(top_n)
                ranks = ranks[top_assets.index]

            weights = ranks / ranks.sum()
            return weights.reindex(scores.index, fill_value=0)

        return pd.Series()

    def backtest_factor_model(self, prices: pd.DataFrame, returns: pd.DataFrame,
                             fundamentals: Optional[Dict] = None,
                             rebalance_frequency: str = 'monthly',
                             method: str = 'long_only',
                             top_n: int = 5) -> pd.Series:
        """
        Backtest the multi-factor model

        Returns:
            Portfolio returns series
        """
        print("\n" + "="*80)
        print("MULTI-FACTOR MODEL BACKTEST")
        print("="*80)
        print(f"Factors: {[f.name for f in self.factors]}")
        print(f"Method: {method}")
        print(f"Top N: {top_n}")
        print(f"Rebalance: {rebalance_frequency}")

        # Calculate factor scores
        factor_scores = self.calculate_factor_scores(prices, returns, fundamentals)

        # Combine factors
        combined = self.combine_factors(factor_scores)

        # Generate weights
        weights = self.generate_portfolio_weights(combined, method, top_n)

        print(f"\nPortfolio Allocation:")
        for ticker, weight in weights[weights > 0].sort_values(ascending=False).items():
            print(f"  {ticker}: {weight:.2%}")

        # Calculate portfolio returns
        # Simple implementation - assumes constant weights
        portfolio_returns = (returns * weights).sum(axis=1)

        return portfolio_returns

    def print_factor_analysis(self):
        """Print detailed factor analysis"""
        if not self.factor_scores:
            print("No factor scores calculated")
            return

        print("\n" + "="*80)
        print("FACTOR ANALYSIS")
        print("="*80)

        for factor_name, scores in self.factor_scores.items():
            print(f"\n{factor_name} Factor:")
            print(f"  Mean: {scores.mean():.3f}")
            print(f"  Std: {scores.std():.3f}")
            print(f"  Min: {scores.min():.3f}")
            print(f"  Max: {scores.max():.3f}")

            # Top and bottom
            print(f"\n  Top 3 assets:")
            for ticker, score in scores.nlargest(3).items():
                print(f"    {ticker}: {score:.3f}")

            print(f"\n  Bottom 3 assets:")
            for ticker, score in scores.nsmallest(3).items():
                print(f"    {ticker}: {score:.3f}")

