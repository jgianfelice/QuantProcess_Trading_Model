class MLRegimePredictor:
    """Predict market regimes using machine learning"""
    
    def __init__(self):
        self.model = GradientBoostingClassifier(
            n_estimators=100,
            max_depth=5,
            random_state=42
        )
        self.scaler = StandardScaler()
        self.is_trained = False
    
    def create_features(self, price: pd.Series, returns: pd.Series) -> pd.DataFrame:
        """Create features for ML model"""
        features = pd.DataFrame(index=price.index)
        
        # Price-based features
        features['returns_5d'] = returns.rolling(5).mean()
        features['returns_20d'] = returns.rolling(20).mean()
        features['returns_60d'] = returns.rolling(60).mean()
        
        # Volatility features
        features['vol_5d'] = returns.rolling(5).std()
        features['vol_20d'] = returns.rolling(20).std()
        features['vol_60d'] = returns.rolling(60).std()
        features['vol_ratio'] = features['vol_5d'] / features['vol_20d']
        
        # Trend features
        features['ma_20'] = price.rolling(20).mean() / price
        features['ma_50'] = price.rolling(50).mean() / price
        features['ma_200'] = price.rolling(200).mean() / price
        
        # Momentum features
        features['rsi'] = compute_rsi(price, 14)
        features['mom_20'] = price.pct_change(20)
        features['mom_60'] = price.pct_change(60)
        
        # Range features
        features['range_20'] = (price.rolling(20).max() - price.rolling(20).min()) / price
        
        return features.fillna(method='ffill').fillna(0)
    
    def train(self, price: pd.Series, returns: pd.Series, 
             regime: pd.Series) -> float:
        """Train the ML model"""
        try:
            features = self.create_features(price, returns)
            
            # Align data
            aligned_data = pd.concat([features, regime], axis=1, join='inner')
            aligned_data = aligned_data.dropna()
            
            if len(aligned_data) < Config.ML_TRAIN_SIZE:
                print(f"  Insufficient data for ML training: {len(aligned_data)} samples (need {Config.ML_TRAIN_SIZE})")
                return 0.0
            
            X = aligned_data.iloc[:, :-1]
            y = aligned_data.iloc[:, -1]
            
            # Encode regime labels
            regime_map = {'Risk-Off': 0, 'Choppy': 1, 'Trend': 2}
            y_encoded = y.map(regime_map)
            
            # Check if we have any NaN after encoding
            if y_encoded.isna().any():
                print(f"  Warning: Unknown regime labels found")
                return 0.0
            
            # Train/test split (time series)
            split_idx = int(len(X) * 0.8)
            if split_idx < 100:  # Need minimum train size
                print(f"  Insufficient data for train/test split")
                return 0.0
                
            X_train, X_test = X[:split_idx], X[split_idx:]
            y_train, y_test = y_encoded[:split_idx], y_encoded[split_idx:]
            
            # Scale features
            X_train_scaled = self.scaler.fit_transform(X_train)
            X_test_scaled = self.scaler.transform(X_test)
            
            # Train model
            self.model.fit(X_train_scaled, y_train)
            self.is_trained = True
            
            # Calculate accuracy
            accuracy = self.model.score(X_test_scaled, y_test)
            
            return accuracy
        except Exception as e:
            print(f"  ML training error: {str(e)}")
            return 0.0
    
    def predict_next_regime(self, price: pd.Series, returns: pd.Series) -> Tuple[str, float]:
        """Predict next regime with confidence"""
        if not self.is_trained:
            return "Unknown", 0.0
        
        features = self.create_features(price, returns)
        latest_features = features.iloc[-1:].values
        
        # Scale
        latest_scaled = self.scaler.transform(latest_features)
        
        # Predict
        prediction = self.model.predict(latest_scaled)[0]
        probabilities = self.model.predict_proba(latest_scaled)[0]
        
        regime_map_inv = {0: 'Risk-Off', 1: 'Choppy', 2: 'Trend'}
        predicted_regime = regime_map_inv[prediction]
        confidence = probabilities[prediction]
        
        return predicted_regime, confidence
    
    def predict_regime_transition(self, price: pd.Series, returns: pd.Series, 
                                  current_regime: str, days_ahead: int = 5) -> Dict:
        """Predict regime transition probability"""
        if not self.is_trained:
            return {}
        
        features = self.create_features(price, returns)
        latest_features = features.iloc[-1:].values
        latest_scaled = self.scaler.transform(latest_features)
        
        probabilities = self.model.predict_proba(latest_scaled)[0]
        
        regime_map_inv = {0: 'Risk-Off', 1: 'Choppy', 2: 'Trend'}
        
        transition_prob = {
            regime_map_inv[i]: prob 
            for i, prob in enumerate(probabilities)
        }
        
        return transition_prob

