# ==================================================

class WalkForwardAnalyzer:
    """Walk-forward optimization and testing"""
    
    def __init__(self, train_years: int = 5, test_years: int = 1):
        self.train_years = train_years
        self.test_years = test_years
    
    def run(self, returns: pd.Series, start_date: pd.Timestamp) -> pd.Series:
        """Execute walk-forward analysis"""
        wf_returns = []
        
        start = pd.to_datetime(start_date)
        end = returns.index[-1]
        
        while start + pd.DateOffset(years=self.train_years + self.test_years) <= end:
            train_end = start + pd.DateOffset(years=self.train_years)
            test_end = train_end + pd.DateOffset(years=self.test_years)
            
            test_slice = returns.loc[train_end:test_end]
            
            if len(test_slice) > 0:
                wf_returns.append(test_slice)
            
            start = start + pd.DateOffset(years=self.test_years)
        
        return pd.concat(wf_returns) if wf_returns else pd.Series()

