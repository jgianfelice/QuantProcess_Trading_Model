class WalkForwardAnalyzer:
    """
    Comprehensive walk-forward optimization and testing

    Features:
    - Parameter optimization on training window
    - Out-of-sample testing
    - Rolling window re-training
    - Performance tracking per window
    - Overfitting detection
    """

    def __init__(self, train_years: int = 8, test_years: int = 4,
                 anchor: bool = False):
        """
        Initialize walk-forward analyzer

        Args:
            train_years: Years for training window (default 8: 2010-2018)
            test_years: Years for testing window (default 4: 2019-2022)
            anchor: If True, always start from beginning (anchored)
                   If False, use rolling window
        """
        self.train_years = train_years
        self.test_years = test_years
        self.anchor = anchor
        self.windows = []
        self.results = []

    def run(self, price: pd.Series, returns: pd.Series,
            start_date: str = '2010-01-01') -> Dict:
        """
        Execute comprehensive walk-forward analysis

        Args:
            price: Price series
            returns: Returns series
            start_date: Start date for analysis

        Returns:
            Dictionary with results
        """
        print("\n" + "="*80)
        print("WALK-FORWARD ANALYSIS")
        print("="*80)
        print(f"Training Period: {self.train_years} years")
        print(f"Testing Period: {self.test_years} years")
        print(f"Method: {'Anchored' if self.anchor else 'Rolling'}")
        print("="*80)

        # Find windows
        self.windows = self._create_windows(returns.index, start_date)

        if not self.windows:
            print("Error: Insufficient data for walk-forward analysis")
            print(f"Need at least {self.train_years + self.test_years} years of data")
            return {}

        print(f"\nTotal Windows: {len(self.windows)}")

        # Process each window
        all_oos_returns = []

        for i, window in enumerate(self.windows, 1):
            print(f"\n--- Window {i}/{len(self.windows)} ---")
            print(f"Train: {window['train_start'].date()} to {window['train_end'].date()}")
            print(f"Test:  {window['test_start'].date()} to {window['test_end'].date()}")

            # Get data for this window
            train_prices = price.loc[window['train_start']:window['train_end']]
            train_returns = returns.loc[window['train_start']:window['train_end']]

            test_prices = price.loc[window['test_start']:window['test_end']]
            test_returns = returns.loc[window['test_start']:window['test_end']]

            if len(train_returns) < 100 or len(test_returns) < 20:
                print("  Skipping: insufficient data")
                continue

            # Optimize parameters on training data
            print("  Optimizing parameters on training data...")
            best_params = self._optimize_parameters(train_prices, train_returns)

            # Test on out-of-sample data
            print(f"  Testing with optimized parameters...")
            oos_returns = self._backtest_with_params(
                test_prices, test_returns, best_params
            )

            if len(oos_returns) > 0:
                all_oos_returns.append(oos_returns)

                # Calculate metrics for this window
                window_metrics = PerformanceAnalytics.calculate_metrics(oos_returns)

                # Store results
                self.results.append({
                    'window': i,
                    'train_start': window['train_start'],
                    'train_end': window['train_end'],
                    'test_start': window['test_start'],
                    'test_end': window['test_end'],
                    'params': best_params,
                    'oos_returns': oos_returns,
                    'metrics': window_metrics
                })

                print(f"  OOS Sharpe: {window_metrics['sharpe']:.2f}")
                print(f"  OOS Return: {window_metrics['total_return']:.2%}")

        # Combine all out-of-sample returns
        if all_oos_returns:
            combined_oos = pd.concat(all_oos_returns)
            combined_oos = combined_oos.sort_index()

            # Calculate overall metrics
            overall_metrics = PerformanceAnalytics.calculate_metrics(combined_oos)

            # Print summary
            self._print_summary(overall_metrics)

            return {
                'oos_returns': combined_oos,
                'overall_metrics': overall_metrics,
                'windows': self.results,
                'num_windows': len(self.results)
            }

        return {}

    def _create_windows(self, date_index: pd.DatetimeIndex,
                       start_date: str) -> List[Dict]:
        """Create train/test windows"""
        windows = []

        start = pd.to_datetime(start_date)
        end = date_index[-1]

        current_start = start

        while True:
            # Training period
            if self.anchor:
                train_start = start  # Anchored: always from beginning
            else:
                train_start = current_start  # Rolling window

            train_end = current_start + pd.DateOffset(years=self.train_years)

            # Testing period
            test_start = train_end
            test_end = test_start + pd.DateOffset(years=self.test_years)

            # Check if we have enough data
            if test_end > end:
                break

            windows.append({
                'train_start': train_start,
                'train_end': train_end,
                'test_start': test_start,
                'test_end': test_end
            })

            # Move forward by test period
            current_start = test_start

        return windows

    def _optimize_parameters(self, price: pd.Series,
                            returns: pd.Series) -> Dict:
        """
        Optimize strategy parameters on training data

        Tests multiple parameter combinations and returns best
        """
        best_sharpe = -np.inf
        best_params = {
            'ma_fast': 50,
            'ma_slow': 200,
            'use_regime': True
        }

        # Parameter ranges to test
        ma_fast_range = [30, 40, 50, 60]
        ma_slow_range = [150, 180, 200, 220]

        for fast in ma_fast_range:
            for slow in ma_slow_range:
                if fast >= slow:
                    continue

                # Backtest with these parameters
                test_returns = self._backtest_ma(price, returns, fast, slow)

                if len(test_returns) > 0 and test_returns.std() > 0:
                    sharpe = test_returns.mean() / test_returns.std() * np.sqrt(252)

                    if sharpe > best_sharpe:
                        best_sharpe = sharpe
                        best_params = {
                            'ma_fast': fast,
                            'ma_slow': slow,
                            'use_regime': True
                        }

        return best_params

    def _backtest_ma(self, price: pd.Series, returns: pd.Series,
                    fast: int, slow: int) -> pd.Series:
        """Backtest MA strategy with given parameters"""
        try:
            ma_fast = price.rolling(fast).mean()
            ma_slow = price.rolling(slow).mean()
            signal = (ma_fast > ma_slow).astype(int)

            # Apply strategy
            strategy_returns = signal.shift(1) * returns

            # Apply transaction costs
            trades = signal.diff().abs()
            strategy_returns -= trades * Config.TRANSACTION_COST

            return strategy_returns.dropna()
        except:
            return pd.Series()

    def _backtest_with_params(self, price: pd.Series, returns: pd.Series,
                             params: Dict) -> pd.Series:
        """Backtest using optimized parameters"""
        return self._backtest_ma(
            price, returns,
            params['ma_fast'],
            params['ma_slow']
        )

    def _print_summary(self, metrics: Dict):
        """Print walk-forward summary"""
        print("\n" + "="*80)
        print("WALK-FORWARD RESULTS (Out-of-Sample)")
        print("="*80)
        print(f"Total Return:        {metrics['total_return']:>10.2%}")
        print(f"CAGR:                {metrics['cagr']:>10.2%}")
        print(f"Sharpe Ratio:        {metrics['sharpe']:>10.2f}")
        print(f"Sortino Ratio:       {metrics['sortino']:>10.2f}")
        print(f"Max Drawdown:        {metrics['max_drawdown']:>10.2%}")
        print(f"Win Rate:            {metrics['win_rate']:>10.2%}")
        print("="*80)

        # Check for overfitting
        if len(self.results) > 0:
            # Compare performance across windows
            sharpes = [r['metrics']['sharpe'] for r in self.results]
            sharpe_std = np.std(sharpes)
            sharpe_mean = np.mean(sharpes)

            print(f"\nConsistency Analysis:")
            print(f"  Average Window Sharpe: {sharpe_mean:.2f}")
            print(f"  Std Dev of Sharpes:    {sharpe_std:.2f}")

            if sharpe_std / abs(sharpe_mean) > 0.5 if sharpe_mean != 0 else True:
                print("  ⚠ Warning: High variance across windows - possible overfitting")
            else:
                print("  ✓ Consistent performance across windows")

    def plot_results(self):
        """Plot walk-forward analysis results"""
        if not self.results:
            print("No results to plot")
            return

        fig, axes = plt.subplots(3, 1, figsize=(14, 10))

        # 1. Cumulative returns by window
        colors = plt.cm.viridis(np.linspace(0, 1, len(self.results)))

        for i, result in enumerate(self.results):
            oos_returns = result['oos_returns']
            equity = (1 + oos_returns).cumprod()

            axes[0].plot(equity.index, equity.values,
                        label=f"Window {result['window']}",
                        color=colors[i], alpha=0.7)

        axes[0].set_ylabel('Cumulative Return')
        axes[0].set_title('Walk-Forward: Out-of-Sample Performance by Window',
                         fontweight='bold')
        axes[0].legend(bbox_to_anchor=(1.05, 1), loc='upper left')
        axes[0].grid(True, alpha=0.3)

        # 2. Sharpe ratio by window
        window_nums = [r['window'] for r in self.results]
        sharpes = [r['metrics']['sharpe'] for r in self.results]

        axes[1].bar(window_nums, sharpes, color='steelblue', alpha=0.7)
        axes[1].axhline(y=np.mean(sharpes), color='red', linestyle='--',
                       label=f'Mean: {np.mean(sharpes):.2f}')
        axes[1].set_xlabel('Window')
        axes[1].set_ylabel('Sharpe Ratio')
        axes[1].set_title('Sharpe Ratio by Window (Consistency Check)')
        axes[1].legend()
        axes[1].grid(True, alpha=0.3)

        # 3. Optimized parameters over time
        ma_fast_params = [r['params']['ma_fast'] for r in self.results]
        ma_slow_params = [r['params']['ma_slow'] for r in self.results]

        axes[2].plot(window_nums, ma_fast_params, marker='o',
                    label='Fast MA', color='green')
        axes[2].plot(window_nums, ma_slow_params, marker='s',
                    label='Slow MA', color='red')
        axes[2].set_xlabel('Window')
        axes[2].set_ylabel('Parameter Value')
        axes[2].set_title('Optimal Parameters Over Time')
        axes[2].legend()
        axes[2].grid(True, alpha=0.3)

        plt.tight_layout()
        plt.show()

    def get_detailed_report(self) -> str:
        """Generate detailed text report"""
        if not self.results:
            return "No results available"

        report = "\n" + "="*80 + "\n"
        report += "DETAILED WALK-FORWARD REPORT\n"
        report += "="*80 + "\n\n"

        for result in self.results:
            report += f"Window {result['window']}:\n"
            report += f"  Training:  {result['train_start'].date()} to {result['train_end'].date()}\n"
            report += f"  Testing:   {result['test_start'].date()} to {result['test_end'].date()}\n"
            report += f"  Parameters: MA({result['params']['ma_fast']}/{result['params']['ma_slow']})\n"
            report += f"  OOS Sharpe: {result['metrics']['sharpe']:>6.2f}\n"
            report += f"  OOS Return: {result['metrics']['total_return']:>6.2%}\n"
            report += f"  Max DD:     {result['metrics']['max_drawdown']:>6.2%}\n"
            report += "\n"

        return report

