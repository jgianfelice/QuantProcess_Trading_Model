    if ticker_input is None:
        print("\nExiting...")
        return

    # Get date range
    start_date, end_date = ui.get_date_range()

    if ticker_input == 'PORTFOLIO':
        # Multi-asset portfolio analysis
        tickers = ui.get_portfolio_tickers()
        if not tickers:
            print("\nNo valid tickers provided. Exiting...")
            return

        # Choose between multi-asset backtest or factor analysis
        print("\nPortfolio Analysis Type:")
        print("1. Multi-Asset Backtest (rebalancing, trailing stops)")
        print("2. Factor Analysis (momentum, volatility, value)")

        analysis_type = input("Enter choice (1/2, default: 1): ").strip()

        if analysis_type == '2':
            # Factor analysis
            include_value = input("\nInclude Value factor? (y/n, default: y): ").strip().lower()
            include_value = include_value != 'n'

            method_choice = input("\nPortfolio method:\n1. Long Only\n2. Long-Short (30/30)\n3. Ranked\n4. Long-Short Decile (Top 10% / Bottom 10%)\nChoice (default: 1): ").strip()
            method_map = {'1': 'long_only', '2': 'long_short', '3': 'ranked', '4': 'long_short_decile'}
            method = method_map.get(method_choice, 'long_only')

            top_n_input = input(f"\nNumber of top holdings (default: {min(5, len(tickers))}): ").strip()
            top_n = int(top_n_input) if top_n_input else min(5, len(tickers))

            run_factor_analysis(
                tickers=tickers,
                start_date=start_date,
                end_date=end_date,
                include_value=include_value,
                method=method,
                top_n=top_n
            )
        else:
            # Multi-asset backtest
            weighting_method = ui.get_weighting_method()

            capital_input = input("\nInitial capital (default: $100,000): ").strip()
            initial_capital = float(capital_input) if capital_input else 100000

            run_multi_asset_backtest(
                tickers=tickers,
                start_date=start_date,
                end_date=end_date,
                weighting_method=weighting_method,
                initial_capital=initial_capital
            )
    else:
        # Single ticker analysis
        mode = ui.get_analysis_mode()

        if mode == '4':
            # Enhanced backtest mode
            capital = input("\nInitial capital (default: $100,000): ").strip()
            initial_capital = float(capital) if capital else 100000
            run_enhanced_backtest(ticker_input, start_date, end_date, initial_capital)

        elif mode == '5':
            # Walk-forward analysis mode
            print("\n--- Walk-Forward Configuration ---")

            # Get parameters
            train_years_input = input("Training years (default: 8 for 2010-2018): ").strip()
            train_years = int(train_years_input) if train_years_input else 8

            test_years_input = input("Testing years (default: 4 for 2019-2022): ").strip()
            test_years = int(test_years_input) if test_years_input else 4

            window_type = input("Window type - (r)olling or (a)nchored (default: rolling): ").strip().lower()
            use_rolling = window_type != 'a'

            run_walk_forward_analysis(
                ticker=ticker_input,
                start_date=start_date,
                end_date=end_date,
                train_years=train_years,
                test_years=test_years,
                use_rolling=use_rolling
            )

        elif mode == '6':
            # Machine Learning mode
            print("\n--- Machine Learning Configuration ---")

            # Get parameters
            horizon_input = input("Prediction horizon in days (default: 5): ").strip()
            target_horizon = int(horizon_input) if horizon_input else 5

            print("\nModel type:")
            print("1. Linear Regression (predict return magnitude)")
            print("2. Logistic Regression (predict direction)")
            print("3. Both")

            model_choice = input("Choice (default: 3): ").strip()
            model_map = {'1': 'linear', '2': 'logistic', '3': 'both'}
            model_type = model_map.get(model_choice, 'both')

            run_ml_analysis(
                ticker=ticker_input,
                start_date=start_date,
                end_date=end_date,
                target_horizon=target_horizon,
                model_type=model_type
            )

        elif mode == '7':
            # Market regime analysis mode
            print("\n--- Market Regime Analysis ---")

            run_regime_analysis(
                ticker=ticker_input,
                start_date=start_date,
                end_date=end_date
            )

        else:
            # Standard analysis modes (1, 2, 3)
            analyze_single_ticker(ticker_input, start_date, end_date, mode)

    print("\n" + "="*80)
    print("Analysis Complete".center(80))
    print("="*80 + "\n")

