class BacktestEngine:
    """Complete backtesting engine orchestrating all components"""

    def __init__(self, initial_capital: float = 100000,
                 risk_manager: Optional[RiskManager] = None,
                 cost_model: Optional[TransactionCostModel] = None):

        self.portfolio = Portfolio(initial_capital, risk_manager, cost_model)
        self.risk_manager = risk_manager or RiskManager()
        self.cost_model = cost_model or TransactionCostModel()

    def run_backtest(self, prices: pd.DataFrame, signals: pd.DataFrame,
                     volatilities: Optional[pd.DataFrame] = None) -> Portfolio:
        """
        Run complete backtest

        Args:
            prices: DataFrame of prices (index=dates, columns=tickers)
            signals: DataFrame of signals (1=long, 0=flat, -1=short)
            volatilities: Optional DataFrame of volatilities

        Returns:
            Portfolio object with complete results
        """
        if volatilities is None:
            # Calculate rolling volatility
            returns = prices.pct_change()
            volatilities = returns.rolling(20).std() * np.sqrt(252)

        # Iterate through time
        for date in prices.index:
            if date not in signals.index:
                continue

            current_prices = prices.loc[date].to_dict()
            current_signals = signals.loc[date]
            current_vols = volatilities.loc[date].to_dict() if date in volatilities.index else {}

            # Update portfolio
            self.portfolio.update(date, current_prices, current_vols)

            # Process signals for each ticker
            for ticker in signals.columns:
                signal = current_signals[ticker]
                price = current_prices.get(ticker)
                vol = current_vols.get(ticker, 0.20)

                if price is None or pd.isna(price):
                    continue

                # Check if we have a position
                has_position = ticker in self.portfolio.positions

                # Entry signal
                if signal != 0 and not has_position:
                    self.portfolio.open_position(ticker, signal, price, date, vol)

                # Exit signal
                elif signal == 0 and has_position:
                    self.portfolio.close_position(ticker, price, date, reason='SIGNAL')

                # Reverse signal (close and open opposite)
                elif has_position:
                    current_pos = self.portfolio.positions[ticker]
                    if (signal > 0 and current_pos.position_type == 'SHORT') or \
                       (signal < 0 and current_pos.position_type == 'LONG'):
                        self.portfolio.close_position(ticker, price, date, reason='REVERSE')
                        self.portfolio.open_position(ticker, signal, price, date, vol)

        # Close all remaining positions at end
        final_date = prices.index[-1]
        final_prices = prices.iloc[-1].to_dict()

        for ticker in list(self.portfolio.positions.keys()):
            if ticker in final_prices:
                self.portfolio.close_position(ticker, final_prices[ticker],
                                             final_date, reason='END')

        return self.portfolio

