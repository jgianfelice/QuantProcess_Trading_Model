class MultiTimeframeAnalyzer:
    """Analyze signals across multiple timeframes"""

    def __init__(self, ticker: str, multi_tf_data: Dict[str, pd.DataFrame]):
        self.ticker = ticker
        self.data = multi_tf_data
        self.signals = {}

    def analyze_all_timeframes(self) -> Dict[str, Dict]:
        """Analyze across all available timeframes"""
        results = {}

        for tf_name, prices in self.data.items():
            if prices is None or len(prices) < 200:
                continue

            price_series = prices[self.ticker] if isinstance(prices, pd.DataFrame) else prices
            returns = price_series.pct_change().dropna()

            # Generate signals for this timeframe
            tf_signals = self._analyze_timeframe(price_series, returns, tf_name)
            results[tf_name] = tf_signals

        return results

    def _analyze_timeframe(self, price: pd.Series, returns: pd.Series,
                          tf_name: str) -> Dict:
        """Analyze a single timeframe"""
        from copy import deepcopy

        # Moving Average
        ma_fast = price.rolling(min(50, len(price)//4)).mean()
        ma_slow = price.rolling(min(200, len(price)//2)).mean()
        ma_signal = "BUY" if ma_fast.iloc[-1] > ma_slow.iloc[-1] else "SELL"

        # RSI
        rsi = compute_rsi(price, min(14, len(price)//10))
        rsi_value = rsi.iloc[-1]
        if rsi_value < 30:
            rsi_signal = "BUY"
        elif rsi_value > 70:
            rsi_signal = "SELL"
        else:
            rsi_signal = "HOLD"

        # Trend
        sma_200 = price.rolling(min(200, len(price)//2)).mean()
        trend = "BULLISH" if price.iloc[-1] > sma_200.iloc[-1] else "BEARISH"

        return {
            'ma_signal': ma_signal,
            'rsi_signal': rsi_signal,
            'trend': trend,
            'rsi_value': rsi_value,
            'price': price.iloc[-1]
        }

    def get_alignment_score(self) -> Tuple[float, Dict]:
        """Calculate alignment score across timeframes"""
        signals = self.analyze_all_timeframes()

        if not signals:
            return 0.0, {}

        # Count bullish signals
        bullish_count = 0
        total_count = 0

        alignment_details = {}

        for tf_name, tf_signals in signals.items():
            if tf_signals['ma_signal'] == 'BUY':
                bullish_count += 1
            total_count += 1

            if tf_signals['rsi_signal'] == 'BUY':
                bullish_count += 0.5
            total_count += 0.5

            if tf_signals['trend'] == 'BULLISH':
                bullish_count += 1
            total_count += 1

            alignment_details[tf_name] = {
                'signal': tf_signals['ma_signal'],
                'trend': tf_signals['trend']
            }

        score = bullish_count / total_count if total_count > 0 else 0.5

        return score, alignment_details

    def get_consensus_signal(self) -> str:
        """Get consensus signal across timeframes"""
        score, _ = self.get_alignment_score()

        if score >= 0.75:
            return "STRONG_BUY"
        elif score >= 0.6:
            return "BUY"
        elif score >= 0.4:
            return "HOLD"
        elif score >= 0.25:
            return "SELL"
        else:
            return "STRONG_SELL"

