def run_walk_forward_analysis(ticker: str, start_date: str = '2010-01-01',
                              end_date: Optional[str] = None,
                              train_years: int = 8, test_years: int = 4,
                              use_rolling: bool = True) -> Dict:
    """
    Run comprehensive walk-forward analysis

    Default: Train 2010-2018 (8 years), Test 2019-2022 (4 years)

    Args:
        ticker: Ticker symbol
        start_date: Start date for entire analysis
        end_date: End date (optional)
        train_years: Years for training (default 8)
        test_years: Years for testing (default 4)
        use_rolling: True for rolling window, False for anchored

    Returns:
        Dictionary with comprehensive results
    """
    print("\n" + "="*80)
    print(f"WALK-FORWARD ANALYSIS - {ticker}")
    print("="*80)
    print(f"Configuration:")
    print(f"  Training Period: {train_years} years")
    print(f"  Testing Period: {test_years} years")
    print(f"  Window Type: {'Rolling' if use_rolling else 'Anchored'}")
    print(f"  Start Date: {start_date}")

    # Fetch data
    print(f"\nFetching data for {ticker}...")
    try:
        prices, returns = DataManager.fetch_data([ticker], start_date, end_date)
        price_series = prices[ticker] if isinstance(prices, pd.DataFrame) else prices
        return_series = returns[ticker] if isinstance(returns, pd.DataFrame) else returns

        print(f"Data loaded: {len(price_series)} days")

        # Check if we have enough data
        total_years_needed = train_years + test_years
        years_available = (price_series.index[-1] - price_series.index[0]).days / 365.25

        if years_available < total_years_needed:
            print(f"\nWarning: Only {years_available:.1f} years of data available")
            print(f"Need at least {total_years_needed} years for walk-forward analysis")
            print("Adjusting parameters...")

            # Adjust parameters
            if years_available >= 10:
                train_years = 6
                test_years = 2
            elif years_available >= 6:
                train_years = 4
                test_years = 1
            else:
                print("Insufficient data for meaningful walk-forward analysis")
                return {}

            print(f"Adjusted: Train {train_years} years, Test {test_years} years")

    except Exception as e:
        print(f"Error fetching data: {e}")
        return {}

    # Create analyzer
    analyzer = WalkForwardAnalyzer(
        train_years=train_years,
        test_years=test_years,
        anchor=not use_rolling
    )

    # Run analysis
    results = analyzer.run(price_series, return_series, start_date)

    if not results:
        print("\nWalk-forward analysis could not be completed")
        return {}

    # Generate detailed report
    print("\n" + analyzer.get_detailed_report())

    # Plot results
    print("\nGenerating visualizations...")
    analyzer.plot_results()

    # Compare to buy-and-hold
    print("\n" + "="*80)
    print("COMPARISON: Walk-Forward vs Buy & Hold")
    print("="*80)

    if 'oos_returns' in results:
        oos_returns = results['oos_returns']

        # Get buy-and-hold for same period
        bh_returns = return_series.loc[oos_returns.index[0]:oos_returns.index[-1]]
        bh_metrics = PerformanceAnalytics.calculate_metrics(bh_returns)

        wf_metrics = results['overall_metrics']

        comparison = pd.DataFrame({
            'Walk-Forward': wf_metrics,
            'Buy & Hold': bh_metrics
        }).T

        print("\nKey Metrics:")
        print(comparison[['total_return', 'cagr', 'sharpe', 'max_drawdown', 'win_rate']])

        # Highlight improvements
        print(f"\nImprovement:")
        print(f"  Sharpe Ratio: {wf_metrics['sharpe'] - bh_metrics['sharpe']:+.2f}")
        print(f"  Max Drawdown: {wf_metrics['max_drawdown'] - bh_metrics['max_drawdown']:+.2%}")

    return results

